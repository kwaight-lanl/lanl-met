' ====================
' Data Tables.
' ====================

DataTable(Dat1min,True,48)  '*Note: data table size fixed to 48 records
  DataInterval(0,1,Min,10)
  ' This table is used to compute speed, direction and time of max sustained
  '    1min gust.

  ' RM Young 05305-AQ Horizontal Wind Speed & Direction Sensor (Level 1)
  WindVector (1,spd1,dir1,FP2,False,0,0,1)  
  FieldNames("spd1min,dir1min")
EndTable

DataTable(Dat15min,True,-1)
  DataInterval(0,15,Min,10)

  ' RM Young 05305-AQ Horizontal Wind Speed & Direction Sensor (Level 1)
  WindVector (1,spd1,dir1,FP2,False,0,0,1)  
  FieldNames("spd1,dir1")
  StdDev (1,spd1,FP2,False)
  FieldNames("sdspd1")
  StdDev (1,dir1,FP2,False)
  FieldNames("sddir1")
  Sample(1, mxgsttoday, FP2)

  ' RM Young 05305-AQ Horizontal Wind Speed & Direction Sensor (Level 2)
  WindVector (1,spd2,dir2,FP2,False,0,0,1)  
  FieldNames("spd2,dir2")
  StdDev (1,spd2,FP2,False)
  FieldNames("sdspd2")
  StdDev (1,dir2,FP2,False)
  FieldNames("sddir2")

  ' RM Young 05305-AQ Horizontal Wind Speed & Direction Sensor (Level 3)
  WindVector (1,spd3,dir3,FP2,False,0,0,1)  
  FieldNames("spd3,dir3")
  StdDev (1,spd3,FP2,False)
  FieldNames("sdspd3")
  StdDev (1,dir3,FP2,False)
  FieldNames("sddir3")

  ' RM Young 27106T Vertical Wind Speed Sensor (Level 1)
  Average(1,w1,FP2,False)  
  FieldNames("w1")
  StdDev(1,w1,FP2,False)  
  FieldNames("sdw1")

  ' RM Young 27106T Vertical Wind Speed Sensor (Level 2)
  Average(1,w2,FP2,False)  
  FieldNames("w2")
  StdDev(1,w2,FP2,False)  
  FieldNames("sdw2")

  ' RM Young 27106T Vertical Wind Speed Sensor (Level 3)
  Average(1,w3,FP2,False)  
  FieldNames("w3")
  StdDev(1,w3,FP2,False)  
  FieldNames("sdw3")

  '  MetOne 060A2 Air Temp Sensor(Level 0)
  Average(1,temp0,FP2,False)
  FieldNames("temp0")
  Sample(1, mntemptoday, FP2)
  Sample(1, mxtemptoday, FP2)

  '  MetOne 060A2 Air Temp Sensor(Level 1)
  Average(1,temp1,FP2,False)
  FieldNames("temp1")

  '  MetOne 060A2 Air Temp Sensor(Level 2)
  Average(1,temp2,FP2,False)
  FieldNames("temp2")

  '  MetOne 060A2 Air Temp Sensor(Level 3)
  Average(1,temp3,FP2,False)
  FieldNames("temp3")

  ' Rotronics MP101A Air Temp & RH Sensor (Level 0)
  Average(1,rh,FP2,False)
  FieldNames("rh")

  'All Weather Tipping Bucket Rain Gauge
  Totalize(1,precip,FP2,False)  

  ' Eppley Precision Spectral Pyranometer *Note: Facing down (swdn)
  Average(1,swdn,IEEE4,False)  'Average solar irradiance

  ' Eppley Precision Spectral Pyranometer *Note: Facing up (swup)
  Average(1,swup,IEEE4,False)  'Average solar irradiance

  ' Eppley Precision Infrared Radiometer *Note: Facing up (lwdn)
  Average(1,lwdn,IEEE4,False)  'Average downward longwave irradiance

  ' Eppley Precision Infrared Radiometer *Note: Facing down (lwup)
  Average(1,lwup,IEEE4,False)  'Average downward longwave irradiance

  ' Net radiation (W/m2)
  Average(1,netrad,IEEE4,False)  'Average net radiation

  ' Campbell Scientific 1-Hour Fuel Moisture
  Average (1,fm1hr,FP2,False)

  ' Campbell Scientific Fuel Moisture Station Package (CS506 & 107L)
  ' Campbell Scientific 10-Hour Fuel Moisture
  Average (1,fm10hr,FP2,False)
  FieldNames("fm10hr")
  Average (1,tempFuel,FP2,False)
  FieldNames("tempFuel")

  ' CS100 Barometric Pressure Sensor 
  Average(1,press,FP2,False)
  FieldNames("press")
EndTable

DataTable(Dat24hr,True,-1)
  DataInterval(0,24,Hr,10)

  ' RM Young 05305-AQ Horizontal Wind Speed & Direction Sensor (Level 1)
  Average(1,spd1,FP2,False)  
  Fieldnames("avgspd1")
  Sample (1,mxgst1,FP2)  
  Sample (1,dirgst1,FP2)  
  Sample(1,tgst1,String)
  Sample (1,mx1gst,FP2)  
  Sample (1,dir1gst,FP2)  
  Sample(1,t1gst,String)

  ' RM Young 05305-AQ Horizontal Wind Speed & Direction Sensor (Level 2)
  Average(1,spd2,FP2,False)  
  Fieldnames("avgspd2")
  Sample (1,mxgst2,FP2)  
  Sample (1,dirgst2,FP2)  
  Sample(1,tgst2,String)

  ' RM Young 05305-AQ Horizontal Wind Speed & Direction Sensor (Level 3)
  Average(1,spd3,FP2,False)  
  Fieldnames("avgspd3")
  Sample (1,mxgst3,FP2)  
  Sample (1,dirgst3,FP2)  
  Sample(1,tgst3,String)

  '  MetOne 060A2 Air Temp Sensor(1)
  Average(1,temp0,FP2,False)  
  Fieldnames("avgtemp0")
  Maximum(1,temp0,FP2,False,False) 
  FieldNames("mxtemp0")
  Sample(1, tmxtemp, String)
  Minimum(1,temp0,FP2,False,False) 
  FieldNames("mntemp0")
  Sample(1, tmntemp, String)

  ' Rotronics MP101A Air Temp & RH Sensor (Level 0)
  Average(1,rh,FP2,False)  
  Fieldnames("avgrh")
  Maximum(1,rh,FP2,False,False) 
  FieldNames("mxrh")
  Minimum(1,rh,FP2,False,False) 
  FieldNames("mnrh")

  'All Weather Tipping Bucket Rain Gauge
  Totalize(1,precip,FP2,False)  
  Fieldnames("tprecip")

  ' Eppley Precision Spectral Pyranometer *Note: Facing down (swdn)
  Totalize(1,swdn_MJm2,IEEE4,False)  'Total flux density
  FieldNames("swedn")

  ' Eppley Precision Spectral Pyranometer *Note: Facing up (swup)
  Totalize(1,swup_MJm2,IEEE4,False)  'Total flux density
  FieldNames("sweup")

  ' Eppley Precision Infrared Radiometer *Note: Facing up (lwdn)
  Totalize(1,lwdn_MJm2,IEEE4,False)  'Total flux density
  FieldNames("lwedn")

  ' Eppley Precision Infrared Radiometer *Note: Facing down (lwup)
  Totalize(1,lwup_MJm2,IEEE4,False)  'Total flux density
  FieldNames("lwedn")

  ' Net radiation (W/m2)
  Average(1,netrad,IEEE4,False)  'Average net radiation
  Fieldnames("nete")

  ' CS100 Barometric Pressure Sensor 
  Average(1,press,FP2,False)  
  Fieldnames("avgpress")
  Maximum(1,press,FP2,False,False) 
  FieldNames("mxpress")
  Minimum(1,press,FP2,False,False) 
  FieldNames("mnpress")
EndTable

DataTable(OpsMonitor,True,-1)
  DataInterval(0,15,Min,0)

  ' MetOne 060A2 Air Temp Sensor(Level 0)
  Average (1,fan0,FP2,False) 
EndTable

' ====================
' Subroutines.
' ====================

' ====================
' Main Program.        
' ====================
BeginProg

' ====================
' Main Loop.        
' ====================
  Scan(3,Sec,1,0)

    ' RM Young 05305-AQ Wind Speed & Direction Sensor (Level 1)
    ' Measure instantaneous wind speed and direction.
    PulseCount(spd1,1,p_wind_horiz_lev1,5,1,0.1024,0)
    BrHalf(dir1,1,mV1000,se_wind_horiz_lev1,ex_wind_horiz_lev1,1,1000,True,0,_60Hz,355,0)
    If dir1>=360 OR dir1<0 Then dir1=0

    ' Keep track of the speed, direction and time of the maximium 3 sec gust.
    If spd1 > mxgst1 Then
      mxgst1 = spd1
      dirgst1 = dir1
      mxgsttoday = mxgst1
      RealTime (HW1Max24HrTime())
      hh = HW1Max24HrTime(4)
      mm = HW1Max24HrTime(5)
      'Sprintf(tgst1, "%02d%02d",INT(hh),INT(mm))
      If hh >= 10 AND mm >= 10 Then
        tgst1 = "" + hh + mm
      ElseIf hh >= 10 AND mm < 10 Then
        tgst1 = "" + hh + "0" + mm
      ElseIf hh < 10 AND mm >= 10 Then
        tgst1 = "0" + hh + mm
      ElseIf hh < 10 AND mm < 10 Then
        tgst1 = "0" + hh + "0" + mm
      EndIf
    EndIf

    ' Keep track of the speed, direction and time of the maximium 1 min gust.
    If Dat1min.spd1min > mx1gst Then
      mx1gst = Dat1min.spd1min
      dir1gst = Dat1min.dir1min
      RealTime (HWTime1_1min())
      hh = HWTime1_1min(4)
      mm = HWTime1_1min(5)
      'Sprintf(t1gst, "%02d%02d",INT(hh),INT(mm))
      If hh >= 10 AND mm >= 10 Then
        t1gst = "" + hh + mm
      ElseIf hh >= 10 AND mm < 10 Then
        t1gst = "" + hh + "0" + mm
      ElseIf hh < 10 AND mm >= 10 Then
        t1gst = "0" + hh + mm
      ElseIf hh < 10 AND mm < 10 Then
        t1gst = "0" + hh + "0" + mm
      EndIf
    EndIf

    ' RM Young 05305-AQ Wind Speed & Direction Sensor (Level 2)
    ' Measure instantaneous wind speed and direction.
    PulseCount(spd2,1,p_wind_horiz_lev2,5,1,0.1024,0)
    ' ktw: Check on RevEx and Settling time arguments.
    BrHalf(dir2,1,mV1000,se_wind_horiz_lev2,ex_wind_horiz_lev2,1,1000,False,20000,_60Hz,355,0)
    If dir2>=360 OR dir2<0 Then dir2=0

    ' Keep track of the speed, direction and time of the maximium 3 sec gust.
    If spd2 > mxgst2 Then
      mxgst2 = spd2
      dirgst2 = dir2
      RealTime (HW2Max24HrTime())
      hh = HW2Max24HrTime(4)
      mm = HW2Max24HrTime(5)
      'Sprintf(tgst2, "%02d%02d",INT(hh),INT(mm))
      If hh >= 10 AND mm >= 10 Then
        tgst2 = "" + hh + mm
      ElseIf hh >= 10 AND mm < 10 Then
        tgst2 = "" + hh + "0" + mm
      ElseIf hh < 10 AND mm >= 10 Then
        tgst2 = "0" + hh + mm
      ElseIf hh < 10 AND mm < 10 Then
        tgst2 = "0" + hh + "0" + mm
      EndIf
    EndIf


    ' RM Young 05305-AQ Wind Speed & Direction Sensor (Level 3)
    ' Measure instantaneous wind speed and direction.
    PulseCount(spd3,1,p_wind_horiz_lev3,5,1,0.1024,0)
    ' ktw: Check on RevEx and Settling time arguments.
    BrHalf(dir3,1,mV1000,se_wind_horiz_lev3,ex_wind_horiz_lev3,1,1000,False,20000,_60Hz,355,0)
    If dir3>=360 OR dir3<0 Then dir3=0

    ' Keep track of the speed, direction and time of the maximium 3 sec gust.
    If spd3 > mxgst3 Then
      mxgst3 = spd3
      dirgst3 = dir3
      RealTime (HW3Max24HrTime())
      hh = HW3Max24HrTime(4)
      mm = HW3Max24HrTime(5)
      'Sprintf(tgst3, "%02d%02d",INT(hh),INT(mm))
      If hh >= 10 AND mm >= 10 Then
        tgst3 = "" + hh + mm
      ElseIf hh >= 10 AND mm < 10 Then
        tgst3 = "" + hh + "0" + mm
      ElseIf hh < 10 AND mm >= 10 Then
        tgst3 = "0" + hh + mm
      ElseIf hh < 10 AND mm < 10 Then
        tgst3 = "0" + hh + "0" + mm
      EndIf
    EndIf


    '  RM Young 27106T Wind Speed Sensor (Level 1)
    '  Wind Speed Sensor measurements 'w1'
    VoltSe(w1,1,mV5000,se_wind_vert_lev1,True,0,_60Hz,0.0225,0)

    '  RM Young 27106T Wind Speed Sensor (Level 2)
    '  Wind Speed Sensor measurements 'w2'
    VoltSe(w2,1,mV5000,se_wind_vert_lev2,True,0,_60Hz,0.0225,0)

    '  RM Young 27106T Wind Speed Sensor (Level 3)
    '  Wind Speed Sensor measurements 'w3'
    VoltSe(w3,1,mV5000,se_wind_vert_lev3,True,0,_60Hz,0.0225,0)

    ' MetOne 060A2 Air Temp Sensor (Level 0)
    BrHalf(temp0,1,mV1000,se_temp_metone_lev0,2,1,1000,False,0,_60Hz,-147.0588,95.7353)
    ' Measure the fan speed in Hz
    PulseCount (fan0,1,p_fan_lev0,3,1,1.0,0)
    
    ' Keep track of daily min/max.
    If temp0 < mntemptoday Then
      mntemptoday = temp0
      RealTime (MinTime())
      hh = MinTime(4)
      mm = MinTime(5)
      'Sprintf(tmntemp, "%02d%02d",hh,mm)
      If hh >= 10 AND mm >= 10 Then
        tmntemp = "" + hh + mm
      ElseIf hh >= 10 AND mm < 10 Then
        tmntemp = "" + hh + "0" + mm
      ElseIf hh < 10 AND mm >= 10 Then
        tmntemp = "0" + hh + mm
      ElseIf hh < 10 AND mm < 10 Then
        tmntemp = "0" + hh + "0" + mm
      EndIf
    EndIf
    If temp0 > mxtemptoday Then
      mxtemptoday = temp0
      RealTime (MaxTime())
      hh = MaxTime(4)
      mm = MaxTime(5)
      'Sprintf(tmxtemp, "%02d%02d",INT(hh),INT(mm))
      If hh >= 10 AND mm >= 10 Then
        tmxtemp = "" + hh + mm
      ElseIf hh >= 10 AND mm < 10 Then
        tmxtemp = "" + hh + "0" + mm
      ElseIf hh < 10 AND mm >= 10 Then
        tmxtemp = "0" + hh + mm
      ElseIf hh < 10 AND mm < 10 Then
        tmxtemp = "0" + hh + "0" + mm
      EndIf
    EndIf

    ' MetOne 060A2 Air Temp Sensor (Level 1)
    BrHalf(temp1,1,mV1000,se_temp_metone_lev1,2,1,1000,False,0,_60Hz,-147.0588,95.7353)
    ' Measure the fan speed in Hz
    PulseCount (fan1,1,p_fan_lev1,3,1,1.0,0)

    ' MetOne 060A2 Air Temp Sensor (Level 2)
    BrHalf(temp2,1,mV1000,se_temp_metone_lev2,2,1,1000,False,0,_60Hz,-147.0588,95.7353)
    ' Measure the fan speed in Hz
    PulseCount (fan2,1,p_fan_lev2,3,1,1.0,0)

    ' MetOne 060A2 Air Temp Sensor (Level 3)
    BrHalf(temp3,1,mV1000,se_temp_metone_lev3,2,1,1000,False,0,_60Hz,-147.0588,95.7353)
    ' Measure the fan speed in Hz
    PulseCount (fan3,1,p_fan_lev3,3,1,1.0,0)

    ' Rotronics MP101A Air Temp & RH Sensor (Level 0)
    VoltSe(rh,1,mV1000,se_rh_rotronics_lev0,0,0,_60Hz,0.1,0)
    if rh < 0.0 then rh = 0.0
    if rh > 100.0 then rh = 100.0
    ' Convert relative humidity to dew point.
    DewPoint(dewp,temp0,rh)
    If dewp>temp0 OR dewp=NAN Then dewp=temp0

    'All Weather Tipping Bucket Rain Gauge
    PulseCount(precip,1,p_precip,1,0,0.01,0)	
    'Change suggested by Alex, original Pconfig for "control ports only", 
    '   suggested use of pull up on pulse channels. From CRBasic help manual:
    'PulseCount ( Dest, Reps, PChan, PConfig, POption, Mult, Offset )
	'PConfig options:
	'Code 	Description
	'0 	Disabled
	'1 	Switch Closure with pull up
	'2 	Switch Closure with pull down (Control ports only)
	'3 	High frequency with pull up
	'4 	High frequency with pull down (Control ports only)
	'5 	Low Level AC (Pulse channels only)

    ' Eppley Precision Spectral Pyranometer *Note: Facing down (swdn)
    VoltDiff(swdn_measure,1,mV20,d_swdn,True,0,_60Hz,1000,0)
    swdn=swdn_measure/SWDNCal  'in W/m2
    swdn_MJm2=(swdn/1000000)*PScan  'in MJ/m2

    ' Eppley Precision Spectral Pyranometer *Note: Facing up (swup)
    VoltDiff(swup_measure,1,mV20,d_swup,True,0,_60Hz,1000,0)
    swup=swup_measure/SWUPCal  'in W/m2
    swup_MJm2=(swup/1000000)*PScan  'in MJ/m2

    ' Eppley Precision Infrared Radiometer *Note: Facing up (lwdn)
    VoltDiff(lwdn_measure,1,mV20C,d_lwdn,True,0,_60Hz,1000,0) 'Eppley PIR
    lwdn=lwdn_measure/LWDNCal  'in W/m2
    lwdn_MJm2=(lwdn/1000000)*PScan  'in MJ/m2

    ' Eppley Precision Infrared Radiometer *Note: Facing down (lwup)
    VoltDiff(lwup_measure,1,mV20C,d_lwup,True,0,_60Hz,1000,0) 'Eppley PIR
    lwup=lwup_measure/LWUPCal  'in W/m2
    lwup_MJm2=(lwup/1000000)*PScan  'in MJ/m2

    ' Net radiation (W/m2)
    netrad = (swdn + lwdn) - (swup +lwup)

' Campbell Scientific 1-Hour Fuel Moisture
    ' Source of previous calculation of EMC and 1 hr fuel moisture is unknown, so
    '   switched to calculations from Cohen and Deeming reference instead. 
    '   The differences in 1 hr fuel moisture were found to be small.
    ' December 2021 - Ken Waight

    ' New calculation of EMC and 1 hr fuel moisture.
    ' Cohen, J.D. and J.E. Deeming, 1982?: The National Fire Danger Rating System: basic equations. 
    '   General Technical Report PSW-82, U.S. Forest Service, Pacific Southwest Forest and Range
    '   Experimental Station.
    ' December 2021 - Ken Waight
    temp0f = (1.8*temp0)+32
    If rh0 < 10 Then
      EMC = 0.03229 + 0.281073*rh0 - 0.000578*temp0f*rh0
    ElseIf rh0>=10 AND rh0 < 50 Then
      EMC = 2.22749 + 0.160107*rh0 - 0.014784*temp0f
    ElseIf rh0>= 50 Then
      EMC = 21.0606 + 0.005565*rh0*rh0 - 0.00035*rh0*temp0f - 0.483199*rh0
    EndIf
    fm1hr = (4.12*EMC+fm10hr)/5.0


    ' Campbell Scientific Fuel Moisture Station Package (CS506 & 107L)
    ' Campbell Scientific 10-Hour Fuel Moisture
    ' CS506 Fuel Moisture Sensor (constant power) measurements
    PortSet(c_fm10hr_portset,1) ' Power on the fuel moisture sensor
    PeriodAvg(FuelM10Hr_uS,1,0,se_fm10hr_moisture,0,0,100,10,1,0)
    PortSet(c_fm10hr_portset,0) ' Power off the fuel moisture sensor
    If FuelM10Hr_uS <= 17.7 Then
      fm10hr=7.6298*FuelM10Hr_uS-130.0904
    Else
      fm10hr=0.0406*FuelM10Hr_uS^2+3.7685*FuelM10Hr_uS-73.7974
    EndIf
    ' CS506 Fuel Temperature Sensor measurement
    Therm107 (tempFuel,1,se_fm10hr_temp,Vx1,0,_60Hz,1,0)

    ' CS100 Barometric Pressure Sensor 
    VoltSe(press,1,mV1000,se_press,0,0,_60Hz,0.2,600)
    ' What was the reason for this line in the old code?
    ' BaroPres_mbar=BaroPres_mbar*1

' =================
' Table calls
' =================

    CallTable dat1min
    CallTable dat15min
    CallTable dat24hr
    CallTable opsMonitor

    If TimeIntoInterval (0,1,Day) Then
      ' Max 3 sec gusts.
      mxgst1 = 0
      dirgst1 = 0
      mxgsttoday = 0

      ' Max 1 min gusts.
      mx1gst = 0
      dir1gst = 0
    EndIf
    If TimeIntoInterval (0,1,Day) Then
      ' Max 3 sec gusts.
      mxgst2 = 0
      dirgst2 = 0
    EndIf
    If TimeIntoInterval (0,1,Day) Then
      ' Max 3 sec gusts.
      mxgst3 = 0
      dirgst3 = 0
    EndIf
    If TimeIntoInterval (0,1,Day) Then
      ' Reset variables at the beginning of a new day. 
      mntemptoday = 99
      mxtemptoday = -99
    EndIf
  NextScan

EndProg
