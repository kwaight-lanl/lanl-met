Const se_wind_horiz_lev3 = 11 'Horiz WindDirection SE11 Channel
Const ex_wind_horiz_lev3 = VX2 'WindDirection Excite VX2 Terminal

' RM Young 27106T Vertical Wind Speed Sensor (Level 3)
