'===========================================================================
'CSAT3B
'*********************************'
'CSAT3B_Definitions & Declarations
Const SDM_ADDR = 3 'SDM Address of Device
Const CSAT_AZIMUTH = 180      'Unique value, Sensor Install Facing True South.
'Compass azimuth of the -x axis. For the figure below, CSAT3B_AZIMUTH = 90.
'() -> Compass coordinate system
'{} -> Right handed coordinate system
'
'                               (N)
'                               {-y}
'                                |
'                                |
'                                |
'                                |
'                                |
'              (W) {+x} <-------[ ]----X--- {-x} (E)
'                              / |      \
'                   CSAT3B Block |    CSAT3B Transducers
'                                |
'                                |
'                                v
'                               {+y}
'                               (S)
'
'The program computes the compass wind direction, using the constant
'CSAT3B_AZIMUTH, and a CSAT3B wind direction. Good CSAT3B wind directions
'are between -90 to 0 and 0 to 90 degrees, e.g. the wind is blowing into
'the CSAT3B sensor head.


Const STATS_INTERVAL = 5    'Period of 30 min for online statistics
Const N_STATS = 1           'Increment size in the totalization functions
Public CSATVals(5)
Public CSATMonitorVals(4)

Alias CSATVals(1) = Ux 'X-Axis wind speed in m/s
Alias CSATVals(2) = Uy 'Y-Axis Wind Speed in m/s
Alias CSATVals(3) = Uz 'Z-Axix Wind Speed in m/s
Alias CSATVals(4) = Ts 'Sonic Temperature in Deg. C
Alias CSATVals(5) = Diag 'Diagnostic Word

Alias CSATMonitorVals(1) = BoardTemp
Alias CSATMonitorVals(2) = BoardHumidity
Alias CSATMonitorVals(3) = InclinePitch
Alias CSATMonitorVals(4) = InclineRoll

Units Ux      = m/s
Units Uy      = m/s
Units Uz      = m/s
Units Ts      = degC
Units Diag    = unitless
Units BoardTemp     = degC
Units BoardHumidity = percent
Units InclinePitch  = deg
Units InclineRoll   = deg

'CSAT3B diagnostic flags
Public diag_bits(9) As Boolean
Alias diag_bits(1) = Flag_LowAmp       'Low Amplitude Flag
Alias diag_bits(2) = Flag_HighAmp      'High Amplitude Flag
Alias diag_bits(3) = Flag_Tracking     'Tracking Flag
Alias diag_bits(4) = Flag_HighDeltaC   'High Delta Speed of Sound Flag
Alias diag_bits(5) = Flag_Acq          'Acquiring Flag
Alias diag_bits(6) = Flag_LowVolt      'Low Supply Voltage Flag
Alias diag_bits(7) = Flag_MemErr       'Memory Error Flag
Alias diag_bits(8) = Flag_ADCSkip      'ADC Clock Error Flag
Alias diag_bits(9) = Flag_TrigErr      'Trigger Error Flag


'
''===========================================================================
'################################################################################
'################################################################################
'##### Declare Units ######## Declare Units ############ Declare Units ####
'################################################################################
'################################################################################
Units BattV=Volts
Units PTemp_C=Deg C
Units avgspd1_ms=meters/second
Units HWDir1_deg=degrees
Units VWSpd1_ms=meters/second
Units AirTemp1_43347_DegC=Deg C
Units AirTemp2_43347_DegC=Deg C
Units Tach_Hz_1=Hz
Units Tach_Hz_2=Hz
Units LWmV=mV
Units LWMDry=Minutes
Units LWMCon=Minutes
Units LWMWet=Minutes
'Units for variables added by JCR, 1/26/18
Units PrecipToday = inch
Units MaxGustToday = meters/second
Units WindChill_15min = Deg C



'===========================================================================
'################################################################################
'################################################################################
'##### Define Data Tables ##################Define Data Tables ##################
'################################################################################
'
'
'Wind directions and speed.
Public wind_out(12)
'Alias wind_out(1) = wind_spd - in compass coord system, same as CSAT3B
'Alias wind_out(2) = result_wind_speed - in compass coord system, same as CSAT3B
Alias wind_out(3)  = dirCSAT
'Alias wind_out(4) = standard_wind_dir - in compass coord system, same as CSAT3B
Alias wind_out(5)  = spdCSAT
Alias wind_out(6)  = result_wind_speed
Alias wind_out(7)  = wind_dir_csat
Alias wind_out(8)  = standard_wind_dir
'Variables for 81000
Alias wind_out(9)  = wind_speed_81000
Alias wind_out(10) = res_ws_81000
Alias wind_out(11) = wind_dir_81000
Alias wind_out(12) = std_winddir_81000
Units dirCSAT      = degrees
Units spdCSAT            = m/s
Units result_wind_speed  = m/s
Units wind_dir_csat      = degrees
Units standard_wind_dir  = degrees
Units wind_speed_81000 = m/s
Units res_ws_81000 = m/s
Units wind_dir_81000 = degress
Units std_winddir_81000 = degrees

'Working variables.
Dim wind_east                      'East wind in compass coordinate system
Dim wind_north                     'North wind in compass coordinate system
Dim diag_integer As Long
Dim disable_stats(2) As Boolean    'Intermediate processing disable flags

'New variables added October 2021, Ken Waight.
Dim WSpdStability
'Variables added for 81000 changes.
Public u81000 'Changed setting to get u-v-w instead of 3D speed-azimuth-elevation.
Public v81000
Public TempK81000
'Variables added for fuel moisture & associated calculation
Public FuelM10Hr_prct, 
Public FuelM10Hr_uS
Public FuelTempC

'Define & Set up CSAT3B Data Tables.

DataTable (CSAT3BSonicData,1,-1)
  Sample (5,CSATVals(1),IEEE4)
EndTable
'
'
DataTable (CSAT3BMonitorData,1,-1)
  DataInterval (0,3,Sec,10)
  Sample (4,CSATMonitorVals(1),IEEE4)
  '
EndTable

DataTable (DataWindVec,TRUE,1)
  DataInterval (0,STATS_INTERVAL,Min,2)
  'Compute wind direction from CSAT data.
  WindVector (1,wind_east,wind_north,IEEE4,disable_stats(1),0,1,2)
  WindVector (1,Uy,Ux,IEEE4,disable_stats(1),0,1,2)
  '  'Compute Wind Dirrection from RMY81000
  WindVector (1,WSpd81000,WDir81000,IEEE4,False,0,1,2)

EndTable

' Statistics data.
DataTable (DataStats,TRUE,-1)
  DataInterval (0,STATS_INTERVAL,Min,2)
  Average (1,Ts,IEEE4,disable_stats(1))
  StdDev  (1,Ts,IEEE4,disable_stats(1))
  Average (1,WSpd81000,IEEE4,False)
  StdDev (1,WSpd81000,IEEE4,False)
  '  Average (1,Ux,IEEE4,disable_stats(1))
  '  StdDev  (1,Ux,IEEE4,disable_stats(1))
  '  Average (1,Uy,IEEE4,disable_stats(1))
  '  StdDev  (1,Uy,IEEE4,disable_stats(1))
  '  Average (1,Uz,IEEE4,disable_stats(1))
  '  StdDev  (1,Uz,IEEE4,disable_stats(1))

  Sample (1,dirCSAT,IEEE4)
  Sample (1,wind_dir_csat,IEEE4)
  Sample (1,spdCSAT,IEEE4)
  Sample (1,result_wind_speed,IEEE4)
  Sample (1,standard_wind_dir,IEEE4)

  Totalize (1,N_STATS,IEEE4,disable_stats(1))
  Totalize (1,N_STATS,IEEE4,NOT (disable_stats(1) OR disable_stats(2)))
  FieldNames ("csat_warnings")
  Totalize (1,N_STATS,IEEE4,NOT (Flag_LowAmp) OR NOT (disable_stats(2)))
  FieldNames ("Flag_LowAmp_Tot")
  Totalize (1,N_STATS,IEEE4,NOT (Flag_HighAmp) OR NOT (disable_stats(2)))
  FieldNames ("Flag_HighAmp_Tot")
  Totalize (1,N_STATS,IEEE4,NOT (Flag_Tracking) OR NOT (disable_stats(2)))
  FieldNames ("Flag_Tracking_Tot")
  Totalize (1,N_STATS,IEEE4,NOT (Flag_HighDeltaC) OR NOT (disable_stats(2)))
  FieldNames ("Flag_HighDeltaC_Tot")
  Totalize (1,N_STATS,IEEE4,NOT (Flag_Acq) OR NOT (disable_stats(2)))
  FieldNames ("Flag_Acq_Tot")
  Totalize (1,N_STATS,IEEE4,NOT (Flag_LowVolt) OR NOT (disable_stats(2)))
  FieldNames ("Flag_LowVolt_Tot")
  Totalize (1,N_STATS,IEEE4,NOT (Flag_MemErr) OR NOT (disable_stats(2)))
  FieldNames ("Flag_MemErr_Tot")
  Totalize (1,N_STATS,IEEE4,NOT (Flag_ADCSkip) OR NOT (disable_stats(2)))
  FieldNames ("Flag_ADCSkip_Tot")
  Totalize (1,N_STATS,IEEE4,NOT (Flag_TrigErr) OR NOT (disable_stats(2)))
  FieldNames ("Flag_TrigErr_Tot")
EndTable
'
'----------------------------------------------------------------------------
'----------------------------------------------------------------------------
'----- 1 Minute Data Table: "Dat1min" , Interval: 1-minute ------------------
'----------------------------------------------------------------------------
'----------------------------------------------------------------------------
'' *Note: This table-readings used to compute speed,direction&time of max sustained
'        1min gust using the WindVector instruction on RMY05305 (1) Wind Sensor.
DataTable(Dat1min,True,48)'*Note: data table size fixed to 48 records
  DataInterval(0,1,Min,10)

  WindVector (1,avgspd1_ms,HWDir1_deg,FP2,False,0,0,0)  'RMY05305 (1) Sensor
  Sample (2,HWTime1_1min(4),FP2)  'RMY05305 (1) time HH,MM
EndTable
'
'----------------------------------------------------------------------------
'----- 15 Minute Data Table: "Dat15min" , Interval: 15-minutes --------------

DataTable(Dat15min,True,-1)
  DataInterval(0,15,Min,10)
  '-----  EPA Wind Vector: Instruction "WindVector" -----------
  'mean horizontal speed, Field Name: "spd1",
  'unit vector mean direction, Field Name: "dir1",
  '& standard deviation of direction, Field Name: "sddir1".
  '-------------------------------------------------------------

  '----- Below Data Output from 05305AQ Horizontal Wind Speed Sensor -----
  WindVector (1,avgspd1_ms,HWDir1_deg,FP2,False,0,0,0)  'RMY05305 (1) Sensor
  FieldNames("spd1,dir1,sddir1")
  'StdDev RMY05305 (1) Wind Speed
  'StdDev(1,avgspd1_ms,FP2,False)
  'FieldNames("avgspd1_StdDev")
  Maximum (1,avgspd1_ms,FP2,False,True)' Max RMY05305 (1) Sensor
  FieldNames("avgspd1_ms_Max,avgspd1_ms_Tmax")
  Minimum (1,avgspd1_ms,FP2,False,True)'Min RMY05305 (1) Sensor
  FieldNames("avgspd1_ms_Min,avgspd1_ms_Tmin")
  Average (1,avgspd1_ms,FP2,False)'Avg RMY05305 (1) Sensor
  FieldNames("avgspd1")
  StdDev (1,avgspd1_ms,FP2,False)'StdDev RMY05305 (1) Sensor
  FieldNames("sdspd1")
  '----- Above Data Output from 05305AQ Horizontal Wind Speed Sensor -----

  '----- Below Data Output from 27106T Vertial Wind Speed Sensor -----
  Maximum (1,VWSpd1_ms,FP2,False,True)'Max RMY27106T(1) Wind Speed
  FieldNames("VWSpd1_Max,VWSp1_TMax")
  Minimum (1,VWSpd1_ms,FP2,False,True)'Min RMY27106T(1) Wind Speed
  FieldNames("VWSpd1_ms_Min,VWSpd1_ms_TMin")
  Average(1,VWSpd1_ms,FP2,False)  'Avg RMY27106T (1) Wind Speed
  FieldNames("w1")
  StdDev(1,VWSpd1_ms,FP2,False)  'StdDev RMY27106T (1) Wind Speed
  FieldNames("sdw1")
  '----- Above Data Output from 27106T Vertial Wind Speed Sensor -----

  '----- Below Data output from BAttery Voltage and Panel Temp mesurements -----
  Maximum (1,BattV,FP2,False,False)
  FieldNames("BattV_Maxvolt")
  Minimum(1,BattV,FP2,False,False)  'Min Battery Voltage
  FieldNames("BattV_MINVolt")
  Average(1,PTemp_C,FP2,False)  'Avg datalogger panel temperature
  FieldNames("PTemp_AVGDegC")
  '----- Above Data output from Battery Voltage and Panel Temp mesurements -----

  '----- Below Data Output from the RPM measurement of the Fan #1 -----
  Maximum (1,Tach_Hz_1,FP2,False,False)
  FieldNames("Tach_Hz_1_Max")
  Minimum (1,Tach_Hz_1,FP2,False,False)
  FieldNames("Tach_Hz_1_Min")
  Average (1,Tach_Hz_1,FP2,False)
  FieldNames("Tach_Hz_1_Avg")
  '----- Above Data Output from the RPM measurement of the Fan #1 -----

  '----- Below Data Output from the RPM measurement of the Fan #2 -----
  Maximum (1,Tach_Hz_2,FP2,False,False)
  FieldNames("Tach_Hz_2_Max")
  Minimum (1,Tach_Hz_2,FP2,False,False)
  FieldNames("Tach_Hz_2_Min")
  Average (1,Tach_Hz_2,FP2,False)
  FieldNames("Tach_Hz_2_Avg")
  '----- Above Data Output from the RPM measurement of the Fan #2 -----

  '----- Below Data Output from AirTemp Sensor #1 -----
  Maximum(1,AirTemp1_43347_DegC,FP2,False,True)'Max RM Young 43347-L1 Air Temp&time HH,MM
  FieldNames("mxtemp,tmxtemp")
  Minimum(1,AirTemp1_43347_DegC,FP2,False,True)'Min RM YOung 43347-L1 Air Temp&time HH,MM
  FieldNames("mntemp,tmntemp")
  Average(1,AirTemp1_43347_DegC,FP2,False)  'Avg RM Young 43347-L1) Air Temp
  FieldNames("temp0")
  StdDev (1,AirTemp1_43347_DegC,FP2,False) 'StdDev RM YOung 43347-L1 Air Temp
  FieldNames("AirTemp1_43347_DegC_StdDev")
  '----- Above Data Output from AirTemp Sensor #1 -----

  '----- Below Data Output from AirTemp Sensor #2 -----
  Maximum(1,AirTemp2_43347_DegC,FP2,False,True) 'Max RM Young 43347-L2 Air Temp&time HH,MM
  FieldNames("AirTemp2_DegC_MAX,AirTemp2_DegC_TMax")
  Minimum(1,AirTemp2_43347_DegC,FP2,False,True) 'Min RM Young 43347-L2 Air Temp&time HH,MM
  FieldNames("AirTemp2_DegC_MIN,AirTemp2_DegC_TMin")
  Average(1,AirTemp2_43347_DegC,FP2,False)  'Avg RM Young 43347-L2 Air Temp
  FieldNames("temp1")
  StdDev (1,AirTemp2_43347_DegC,FP2,False) 'StdDev RM Young 43347-L2 Air Temp
  FieldNames("AirTemp2_43347_DegC_StdDev")
  '----- Above Data Output from AirTemp Sensor #2 -----

  '----- Below Data Output from the CSAT3B Sensor -----
  Maximum (1,Ts,IEEE4,False,True)
  FieldNames("Ts_Max,TS_Tmax")
  Minimum (1,Ts,IEEE4,False,True)
  FieldNames("Ts_Min,Ts_TMin")
  Average (1,Ts,IEEE4,disable_stats(1))
  FieldNames("Ts_Avg")
  StdDev  (1,Ts,IEEE4,disable_stats(1))
  FieldNames("Ts_StdDev")
  Maximum (1,WSpd81000,IEEE4,False,True)
  '----- Above Data Output from the CSAT3B Sensor -----

  '----- Below Data Output from the 81000 RMYoung Sensor -----
  FieldNames("spd81000_Max")
  Minimum (1,WSpd81000,IEEE4,False,True)
  FieldNames("spd81000_Min")
  Average (1,WSpd81000,IEEE4,False)
  FieldNames("spd81000_Avg")
  StdDev  (1,WSpd81000,IEEE4,False))
  FieldNames("spd81000_StdDev")
  Maximum (1,Ux,IEEE4,False,True)
  FieldNames("Ux_Max,Ux_Tmax")
  Minimum (1,Ux,IEEE4,False,True)
  FieldNames("Ux_Min,Ux_TMin")
  Average (1,Ux,IEEE4,disable_stats(1))
  FieldNames("UX_Avg")
  StdDev  (1,Ux,IEEE4,disable_stats(1))
  FieldNames("Ux_StdDev")
  Maximum (1,Uy,IEEE4,False,True)
  FieldNames("Uy_Max,Uy_Tmax")
  Minimum (1,Uy,IEEE4,False,True)
  FieldNames("Uy_Min,Uy_TMin")
  Average (1,Uy,IEEE4,disable_stats(1))
  FieldNames("Uy_Avg")
  StdDev  (1,Uy,IEEE4,disable_stats(1))
  FieldNames("Uy_StdDev")
  Maximum (1,Uz,IEEE4,False,True)
  FieldNames("Uz_Max,Uz_Tmax")
  Minimum (1,Uz,IEEE4,False,True)
  FieldNames("Uz_Min,Uz_TMin")
  Average (1,Uz,IEEE4,disable_stats(1))
  FieldNames("wCSAT")
  StdDev  (1,Uz,IEEE4,disable_stats(1))
  FieldNames("sdwCSAT")
  Sample (1,dirCSAT,IEEE4)
  Sample (1,wind_dir_csat,IEEE4)
  Sample (1,spdCSAT,IEEE4)
  Sample (1,result_wind_speed,IEEE4)
  Sample (1,standard_wind_dir,IEEE4)
  '----- Above Data Output from the CSAT3B Sensor -----

  '----- Below Data Output from the RM Young 81000 Sensor -----
  WindVector(1,WSpd81000,WDir81000,FP2,False,0,0,1)
  FieldNames("spd81000,dir81000")
  '  WindVector(1,U,V,FP2,sonic_disable_flg,0,1,2)
  '  FieldNames("WS61S,WS61V,WDHR61V,WDHR61T")
  'Preceeding 2 lines produce (in order) Scalar Average Horiz Wind Speed,
  'Vector Average Horiz Wind Speed, Vector Average Horiz Wind Dir, and
  'Standard Deviation of Wind Direction.
  'Standard Deviation of Wind Direction.
  Average(1,EleveAngle81000,FP2,False) 'Vert wind direction 61m-scalar
  FieldNames("EleveAngle81000S") 'Keeping unnecessary EleveAngle variables to preserve output order.
  StdDev(1,EleveAngle81000,FP2,False) 'Vert wind direction linear sigma
  FieldNames("EleveAngle81000L")
  '  Average(1,Elevation,FP2,sonic_disable_flg) 'Vert wind direction 61m-scalar
  '  FieldNames("WDVR61S")
  '  StdDev(1,Elevation,FP2,sonic_disable_flg) 'Vert wind direction linear sigma
  '  FieldNames("WDVR61L")
  '  StdDev(1,Speed2,FP2,sonic_disable_flg) 'Horiz wind speed linear sigma
  '  FieldNames("WS61L")
  Average(1,TempC81000,FP2,False) 'Scalar Sonic Temperature
  FieldNames("TempC81000Ss")
  StdDev(1,TempC81000,FP2,False) 'Sonic Temperature linear sigma
  FieldNames("TempC81000Ls")
  'Sample (1,VertWS81000,FP2)
  Average (1,VertWS81000,FP2,False)
  FieldNames ("w81000")
  StdDev (1,VertWS81000,FP2,False)
  fieldnames ("sdw81000")
  '  Average(1,Ts,FP2,sonic_disable_flg) 'Scalar Sonic Temperature
  '  FieldNames("T61Ss")
  '  StdDev(1,Ts,FP2,sonic_disable_flg) 'Sonic Temperature linear sigma
  '  FieldNames("T61Ls")

  ' Maximum(1,WSpd81000,IEEE4,0,True) 'Maximum wind speed
  ' FieldNames("WSpd81000D")
  '  Maximum(1,Speed2,FP2,sonic_disable_flg,0) 'Maximum wind speed
  '  FieldNames("WS61MAX")
  '  Maximum(1,Speed2,FP2,sonic_disable_flg,0) 'Maximum wind speed
  '  FieldNames("WS61MAX2D")
  '  Maximum(1,Speed3,FP2,sonic_disable_flg,0) 'Maximum wind speed
  '  FieldNames("WS61MAX3D")
  '  Average(1,IIF(NOT sonic_disable_flg, 1.0, 0.0),FP2,false)'Percentage of "good" samples
  '  FieldNames("Validity")
  '----- Above Data Output from the RM Young 81000 Sensor -----

  '----- Below Data Output from the CSI Leaf Wetness Sensor -----
  Sample(1,LWmV,FP2)
  Totalize(1,LWMDry,FP2,False)
  Totalize(1,LWMCon,FP2,False)
  Totalize(1,LWMWet,FP2,False)
  '----- Above Data Output from the CSI Leaf Wetness Sensor -----
  Average (1,FuelM10Hr_prct,FP2,False)
  Average (1,FuelTempC,FP2,False)
EndTable
'***********************************************************************************
'
'-----------------------------------------------------------------------------------
'-----------------------------------------------------------------------------------
'----- Data Table: "Dat24Hr" , Interval: 24Hr --------------------------------------
'-----------------------------------------------------------------------------------
DataTable(Dat24Hr,True,-1)
  DataInterval(0,1440,Min,10)
  '----------------------------------------------------------------------
  Average(1,avgspd1_ms,FP2,False)  ' Avg RMY05305 (1) Wind Speed
  '----------------------------------------------------------------------
  Sample (1,mxgst1,FP2)  ' Max 24Hr RMY05305 (1) Wind Speed
  '----------------------------------------------------------------------
  Sample (1,dirgst1,FP2)  ' Max 24Hr RMY05305 (1) Direction
  '----------------------------------------------------------------------
  Sample (2,HW1Max24HrTime(4),FP2)  ' Max 24Hr RMY05305 (1) time HH,MM
  '----------------------------------------------------------------------
  Sample (1,mx1gst,FP2)  'Max 1min sustained RMY05305 (1) Wind Speed
  Sample (1,dir1gst,FP2)  'Max 1min sustained RMY05305 (1) Wind Direction
  Sample (2,HWTime1_max1min(4),FP2)  'Max 1min sustained RMY05305 (1) time HH,MM
  '----------------------------------------------------------------------
  Maximum(1,AirTemp1_43347_DegC,FP2,False,True)'Max RM Young 43347-L1 Air Temp&time HH,MM
  FieldNames("mxtemp,tmxtemp")
  Minimum(1,AirTemp1_43347_DegC,FP2,False,True)'Min RM YOung 43347-L1 Air Temp&time HH,MM
  FieldNames("mntemp,tmntemp")
  '----------------------------------------------------------------------
  Maximum(1,AirTemp2_43347_DegC,FP2,False,True)'Max RM Young 43347-L2 Air Temp&time HH,MM
  FieldNames("AirTemp2_DegC_MAX,AirTemp2_DegC_TMax")
  Minimum(1,AirTemp2_43347_DegC,FP2,False,True)'Min RM Young 43347-L2 Air Temp&time HH,MM
  FieldNames("AirTemp2_DegC_MIN,AirTemp2_DegC_TMin")
  '----------------------------------------------------------------------
  Minimum(1,BattV,FP2,False,False)  ' Min Battery Voltage
  FieldNames("BattV_MINVolt")
  Minimum(1,PTemp_C,FP2,False,False)  ' Min datalogger Panel Temperature
  FieldNames("PTemp_MINDegC")
  Maximum(1,PTemp_C,FP2,False,False)  ' Max datalogger Panel Temperature
  FieldNames("PTemp_MAXDegC")
  '----------------------------------------------------------------------
  Average (1,FuelM10Hr_prct,FP2,False)
  Minimum (1,FuelM10Hr_prct,FP2,False,False)
  Maximum (1,FuelM10Hr_prct,FP2,False,False)
  Average (1,FuelTempC,FP2,False)

EndTable
'***********************************************************************************
'
'===========================================================================
'15 minute table to store values that will be sent to Public table every 15 minutes
'===========================================================================
'Added by JCR 1/26/18
DataTable (Public15,True,1)
  DataInterval (0,15,Min,10)
  '  Totalize (1,Rain_inch,FP2,False)
  Maximum (1,avgspd1_ms,FP2,avgspd1_ms=NAN,False)
  Average (1,WindChill_C,FP2,False)
EndTable
'===========================================================================

'=========================================================================
Sub Stability
  'Find Vertical Pasquill-Gifford Stability Category
  Select Case SigmaPhi
  Case < 2.890
    V_PGCat = "F"
  Case < 6.022
    V_PGCat = "E"
  Case <9.394
    V_PGCat = "D"
  Case < 12.043
    V_PGCat = "C"
  Case < 13.85
    V_PGCat = "B"
  Case >=13.85
    V_PGCat = "A"
  End Select
  If Sun = True Then
    If V_PGCat = "A" Then
      Select Case WSpdStability
      Case < 3
        V_PGCat = "A"
      Case < 4
        V_PGCat = "B"
      Case < 6
        V_PGCat = "C"
      Case >=6
        V_PGCat = "D"
      EndSelect
    ElseIf V_PGCat = "B" Then
      Select Case WSpdStability
      Case < 4
        V_PGCat = "B"
      Case < 6
        V_PGCat = "C"
      Case >=6
        V_PGCat = "D"
      EndSelect
    ElseIf V_PGCat = "C" Then
      If WSpdStability >= 6 Then V_PGCat = "D"
    ElseIf V_PGCat = "D" Then
      V_PGCat = "D"
    ElseIf V_PGCat = "E" Then
      V_PGCat = "D"
    ElseIf V_PGCat = "F" Then
      V_PGCat = "D"
    EndIf
  Else
    If V_PGCat = "A" Then
      V_PGCat = "D"
    ElseIf V_PGCat = "B" Then
      V_PGCat = "D"
    ElseIf V_PGCat = "C" Then
      V_PGCat = "D"
    ElseIf V_PGCat = "D" Then
      V_PGCat = "D"
    ElseIf V_PGCat = "E" Then
      If WSpdStability >= 5 Then V_PGCat = "D"
    ElseIf V_PGCat = "F" Then
      Select Case WSpdStability
      Case < 3
        V_PGCat = "F"
      Case < 5
        V_PGCat = "E"
      Case >=5
        V_PGCat = "D"
      EndSelect
    EndIf
  EndIf
  'Find Lateral Pasquill-Gifford Stability Category
  Select Case SigmaTheta
  Case < 4.576
    H_PGCat = "F"
  Case < 9.032
    H_PGCat = "E"
  Case <15.054
    H_PGCat = "D"
  Case < 21.075
    H_PGCat = "C"
  Case < 27.097
    H_PGCat = "B"
  Case >=27.097
    H_PGCat = "A"
  End Select
  If Sun = True Then
    If H_PGCat = "A" Then
      Select Case WSpdStability
      Case < 3
        H_PGCat = "A"
      Case < 4
        H_PGCat = "B"
      Case < 6
        H_PGCat = "C"
      Case >=6
        H_PGCat = "D"
      EndSelect
    ElseIf H_PGCat = "B" Then
      Select Case WSpdStability
      Case < 4
        H_PGCat = "B"
      Case < 6
        H_PGCat = "C"
      Case >=6
        H_PGCat = "D"
      EndSelect
    ElseIf H_PGCat = "C" Then
      If WSpdStability >= 6 Then H_PGCat = "D"
    ElseIf H_PGCat = "D" Then
      H_PGCat = "D"
    ElseIf H_PGCat = "E" Then
      H_PGCat = "D"
    ElseIf H_PGCat = "F" Then
      H_PGCat = "D"
    EndIf
  Else
    If H_PGCat = "A" Then
      Select Case WSpdStability
      Case < 2.9
        H_PGCat = "F"
      Case < 3.6
        H_PGCat = "E"
      Case >= 3.6
        H_PGCat = "D"
      EndSelect
    ElseIf H_PGCat = "B" Then
      Select Case WSpdStability
      Case < 2.4
        H_PGCat = "F"
      Case < 3
        H_PGCat = "E"
      Case >= 3
        H_PGCat = "D"
      EndSelect
    ElseIf H_PGCat = "C" Then
      Select Case WSpdStability
      Case < 2.4
        H_PGCat = "E"
      Case >= 2.4
        H_PGCat = "D"
      EndSelect
    ElseIf H_PGCat = "D" Then
      H_PGCat = "D"
    ElseIf H_PGCat = "E" Then
      If WSpdStability >= 5 Then H_PGCat = "D"
    ElseIf H_PGCat = "F" Then
      Select Case WSpdStability
      Case < 3
        H_PGCat = "F"
      Case < 5
        H_PGCat = "E"
      Case >=5
        H_PGCat = "D"
      EndSelect
    EndIf
  EndIf
EndSub
' End of subroutine to calculate P-G Stability Category
'=========================================================================

'###############################################################################
'###############################################################################
'     Main Program        Main Program           Main Program
'##############################################################################
'##############################################################################
BeginProg
  Scan(Scan_Rate,Sec,1,0)
    '---------------------------------------------------------------------
    ' Datalogger Battery Voltage measurement 'BattV'
    Battery(BattV)
    ' Datalogger Wiring Panel Temperature measurement 'PTemp_C'
    PanelTemp(PTemp_C,_60Hz)
    '---------------------------------------------------------------------
    '  #1 RMYoung 05305-AQ Wind Speed & Direction Sensor
    '  avgspd1_ms' and 'HWDir1_deg'
    PulseCount(avgspd1_ms,1,1,1,1,0.1024,0)
    BrHalf(HWDir1_deg,1,mV5000,1,1,1,5000,True,0,_60Hz,355,0)
    If HWDir1_deg>=360 OR HWDir1_deg<0 Then HWDir1_deg=0
    '---------------------------------------------------------------------
    ' Determine the HWSpeed, Direction & Time of Max Gust 4-levels
    ' for a 24Hr period
    If avgspd1_ms > mxgst1 Then
      mxgst1 = avgspd1_ms
      dirgst1 = HWDir1_deg
      RealTime (HW1Max24HrTime())
    EndIf
    '---------------------------------------------------------------------
    '  #1 RMYoung 27106T Wind Speed Sensor measurements 'VWSpd1_ms'
    VoltSe(VWSpd1_ms,1,mV5000,5,True,0,_60Hz,0.0225,0)

    '-------------------------------------------------------------------------

    '-----------------------------------------------------------------------
    '  RM Young 43347 Air Temp Sensor(1)
    '  measurements 'AirTemp1_DegC' for calibrated sensor
    Resistance (RTD_Res_1,1,mV200,4,Ix1,1,170,True ,True ,0,_60Hz,1.0,0)
    AirTemp1_43347_DegC = T1_Co1+((RTD_Res_1)*T1_Co2)+((RTD_Res_1^2)*T1_Co3)

    'Measure the fan speed, in Hz, for the AirTemp1_43347_DegC sensor
    PulseCount (Tach_Hz_1,1,2,0,1,1.0,0)
    '=======================================================================
    temp0_F = 1.8*AirTemp1_43347_DegC + 32 'Convert air temp to deg F for wind chill calculation
    speed1_mph = 2.23694*avgspd1_ms 'Convert level 1 wind speed to mph for wind chill calculation
    WindChill_F = 35.74 + (0.6215*temp0_F) - (35.75*speed1_mph^0.16) + (0.4275*temp0_F*speed1_mph^0.16)
    WindChill_C = (WindChill_F -32)/1.8 'Convert wind chill to deg C
    '=======================================================================
    '  RM Young 43347 Air Temp Sensor(2)
    '  measurements 'AirTemp2_DegC' for calibrated sensor
    Resistance (RTD_Res_2,1,mV200,5,Ix2,1,170,True ,True ,0,_60Hz,1.0,0)
    AirTemp2_43347_DegC = T2_Co1+((RTD_Res_2)*T2_Co2)+((RTD_Res_2^2)*T2_Co3)

    'Measure the fan speed, in Hz, for the AirTemp2_43347_DegC sensor
    PulseCount (Tach_Hz_2,1,3,0,1,1.0,0)
    '-------------------------------------------------------------------------

    'RMY81000
    'Make the voltage measurements for the 81000
    'Changed instrument settings so that voltage output format=1 (u-v-w) instead of 2 (3D speed-azimuth-elevation).
    VoltSe (u81000,1,mV5000,11,1,0,_60Hz,0.02,-50)
    VoltSe (v81000,1,mV5000,12,1,0,_60Hz,0.02,-50)
    VoltSe (VertWS81000,1,mV5000,13,1,0,_60Hz,0.02,-50)
    VoltSe (TempK81000,1,mV5000,14,1,0,_60Hz,0.02,220) 'Temp relationship is different than u-v-w
    TempC81000 = TempK81000 - 273.15
    EleveAngle81000 = 0.0

    'Calculate horizontal wind speed from u and v.
    WSpd81000 = SQR(u81000*u81000 + v81000*v81000)

    'Calculate wind direction from u and v.
    if u81000 = 0.0 and v81000 = 0.0 then
        WDir81000 = 0.0
    elseif u81000 = 0.0 and v81000 > 0.0 then
        WDir81000 = 180.0
    elseif u81000 = 0.0 and v81000 < 0.0 then
        WDir81000 = 0.0
    else
        WDir81000 = ATN2(u81000, v81000)
    EndIf

    '-------------------------------------------------------------------------
    '------------------------------------------------------------------------
    'LWS Dielectric Leaf Wetness Sensor measurement 'LWmV'
    BrHalf(LWmV,1,mV5000,3,Vx3,1,2500,False,10000,60,2500,0)
    'Determine Minutes Dry 'LWMDry', Minutes Wet or Contaminated 'LWMCon',
    'and Minutes Wet 'LWMWet'. The value 0.08333333 is the scan rate divided by
    '60 s (5 s/60 s = 0.08333333).
    LWMDry=0
    LWMCon=0
    LWMWet=0
    If LWmV<274 Then
      LWMDry=Scan_Rate/60
    Else
      If LWmV>=284 Then
        LWMWet=Scan_Rate/60
      Else
        LWMCon=Scan_Rate/60
      EndIf
    EndIf

    '-------------------------------------------------------------------------
    '################## ADD CSAT3B MEASUREMENT INSTRUCTIONS ###################
    ' CSI CSAT3B
    CSAT3B (CSATVals(),0,3,0)

    'Copy and convert CSAT3B for compass wind vector computation.
    wind_east = -1*Uy
    wind_north = Ux

    'Break up the warning flags into separate bits.
    diag_integer = Diag
    diag_bits(1) = diag_integer AND &h00000001
    diag_bits(2) = diag_integer AND &h00000002
    diag_bits(3) = diag_integer AND &h00000004
    diag_bits(4) = diag_integer AND &h00000008
    diag_bits(5) = diag_integer AND &h00000010
    diag_bits(6) = diag_integer AND &h00000020
    diag_bits(7) = diag_integer AND &h00000040
    diag_bits(8) = diag_integer AND &h00000080
    diag_bits(9) = diag_integer AND &h00000100

    'Turn on this intermediate processing disable flag when any
    'warning flag is set or the data returned is NaN
    disable_stats(1) = ((diag_integer AND &hffffffff) OR (Diag = NaN))
    'Turn on this intermediate processing disable flag only when
    'CSAT3B diagnostic warning flags are set
    disable_stats(2) = ((diag_integer AND &hffffffff) AND NOT (Diag = NaN))

    'Compute the online wind vector statistics.
    CallTable DataWindVec

    If (DataWindVec.Output(1,1) ) Then
      GetRecord (wind_out(1),DataWindVec,1)
      'Compass wind direction will be 0 to 360 degrees.
      dirCSAT = (dirCSAT+CSAT_AZIMUTH) MOD 360
      'CSAT wind direction will be 0 to 180 or 0 to -180 degrees.
      If ( wind_dir_csat ) > 180 Then ( wind_dir_csat = wind_dir_csat-360 )
    EndIf

    CallTable DataStats

    '----------------------------------------------------------
    ' Read Time every 1minute ---------------------------------
    If TimeIntoInterval (0,1,Min) Then
      RealTime (HWTime1_1min())
    EndIf
    '

    ' CS505 Fuel Moisture Sensor (constant power) measurements
    PortSet(5,1) ' Power on the fuel moisture sensor
    PeriodAvg(FuelM10Hr_uS,1,mV1000,21,0,0,100,10,1,0)
    PortSet(5,0)
    If FuelM10Hr_uS <= 17.7 Then
      FuelM10Hr_prct=7.6298*FuelM10Hr_uS-130.0904
    Else
      FuelM10Hr_prct=0.0406*FuelM10Hr_uS^2+3.7685*FuelM10Hr_uS-73.7974
    EndIf

    ' CS205 Fuel Temperature Sensor measurement
    Therm107(FuelTempC,1,19,Vx4,0,_60Hz,1,0)

    '--------------------------------------------------------------------
    'Call Output Tables --------------------------------------------------
    CallTable Dat1min
    '----------------------------------------------------------------------
    ' Redirect DatTable "Dat1min" variables to program variables ----------
    avgspd1_1min = Dat1min.avgspd1_ms_WVc(1,1)
    HWDir1_1min = Dat1min.avgspd1_ms_WVc(2,1)
    '----------------------------------------------------------------------
    ' Determine the HWSpeed, HWDirection & Time of Max 1min sustained gust 1-level
    ' for a 24Hr period and store into program varialbes for a 24Hr period
    If avgspd1_1min > mx1gst Then
      mx1gst = avgspd1_1min
      dir1gst = HWDir1_1min
      HWTime1_max1min(4) = HWTime1_1min(4)
      HWTime1_max1min(5) = HWTime1_1min(5)
    EndIf
    '---------------------------------
    'Call Data Tables and Store Data
    '---------------------------------
    CallTable(Dat15min)
    CallTable(Dat24Hr)
    CallTable(CSAT3BSonicData)
    CallTable(CSAT3BMonitorData)
    '=======================================================================
    CallTable(Public15) 'Added 1/26/18 by JCR for 15 minute Public table variables
    'moved stability calculations immediately after calling tables
    'to ensure that data used in calculation
    'is from the last 15 minutes. Jason Ritter, CSI, 2/22/18
    'Calculate stability (sigma phi and sigma theta) at level-1 only
    'in the Public table every 15 minutes

    If IfTime(0,15,min) Then
      'Calculate stdev of vertical and horizontal wind
      SigmaPhi = (Dat15min.sdw1(1,1)/Dat15min.spd1(1,1))*57.2958
      SigmaTheta = Dat15min.sddir1(1,1)
      WSpdStability = Dat15Min.spd1(1,1)
      Call Stability

      '      PrecipToday=PrecipToday + Public15.Rain_inch_TOT
      WindChill_15min=Public15.WindChill_C_AVG
      If Public15.avgspd1_ms_MAX>MaxGustToday Then
        MaxGustToday=Public15.avgspd1_ms_MAX
      EndIf
    EndIf
    '=======================================================================
    '---------------------------------------------------------------------
    ' At the beginning of a new day reset 24Hr variables
    If TimeIntoInterval (0,1,Day) Then
      mx1gst = 0
      dir1gst = 0
      HWTime1_max1min(4) = 0
      HWTime1_max1min(5) = 0

      mxgst1=0
      dirgst1=0
      HW1Max24HrTime(4)=0  'hour
      HW1Max24HrTime(5)=0  'minute
      '
      HWSpd2Max24Hr=0
      HWDir2Max24Hr=0
      HW2Max24HrTime(4)=0  'hour
      HW2Max24HrTime(5)=0  'minute
      '
      HWSpd3Max24Hr=0
      HWDir3Max24Hr=0
      HW3Max24HrTime(4)=0  'hour
      HW3Max24HrTime(5)=0  'minute
      '
      HWSpd4Max24Hr=0
      HWDir4Max24Hr=0
      HW4Max24HrTime(4)=0  'hour
      HW4Max24HrTime(5)=0  'minute
      PrecipToday=0
      MaxGustToday=0
      '=========================================================================

    EndIf

  NextScan
  SlowSequence

  Scan(3,sec,0,0)        '3 second scan 'CSAT3BMonitor (Destination, Bus, Address)
    CSAT3BMonitor(CSATMonitorVals(),0,SDM_ADDR)
    CallTable(CSAT3BMonitorData)
  NextScan

EndProg
'**************************************************************************
'**************************************************************************
'**************************************************************************
␀␀␀␀␀␀␀␀␀␀␀