Const PScan=3  'enter program execution interval in seconds
Const PSP1Cal=10.49 ' Enter PSP1Cal = Eppley Sensitivity Cal Constant in microVolt/WM^2
Const PSP2Cal=11.12 ' Enter PSP2Cal = Eppley Sensitivity Cal Constant in microVolt/WM^2
Const PIR1Cal=3.30 ' Enter PIR1Cal = Eppley Sensitivity Cal Constant in microVolt/WM^2
Const PIR2Cal=4.11 ' Enter PIR2Cal = Eppley Sensitivity Cal Constant in microVolt/WM^2
'Const SR50_offset Zero Ref. Surface SR50 transducer height in inches
Const SR50_offset = 83.4100 'SR50 transducer height in inches ' Changed 12-01-2022 GTS

