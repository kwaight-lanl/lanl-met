'-----------------------------------------------------------------------------------
'----- Data Table: "Dat24Hr" , Interval: 24Hr --------------------------------------
'-----------------------------------------------------------------------------------
DataTable(Dat24Hr,True,-1)
  DataInterval(0,1440,Min,10)
  '----------------------------------------------------------------------
  Average(1,HWSpd1_ms,FP2,False)  ' Avg RMY05305 (1) Wind Speed
  Average(1,HWSpd2_ms,FP2,False)  ' Avg RMY05305 (2) Wind Speed
  Average(1,HWSpd3_ms,FP2,False)  ' Avg RMY05305 (3) Wind Speed
  Average(1,HWSpd4_ms,FP2,False)  ' Avg RMY05305 (4) Wind Speed
  '----------------------------------------------------------------------
  Sample (1,HWSpd1Max24Hr,FP2)  ' Max 24Hr RMY05305 (1) Wind Speed
  Sample (1,HWSpd2Max24Hr,FP2)  ' Max 24Hr RMY05305 (2) Wind Speed
  Sample (1,HWSpd3Max24Hr,FP2)  ' Max 24Hr RMY05305 (3) Wind Speed
  Sample (1,HWSpd4Max24Hr,FP2)  ' Max 24Hr RMY05305 (4) Wind Speed
  '----------------------------------------------------------------------
  Sample (1,HWDir1Max24Hr,FP2)  ' Max 24Hr RMY05305 (1) Direction
  Sample (1,HWDir2Max24Hr,FP2)  ' Max 24Hr RMY05305 (2) Direction
  Sample (1,HWDir3Max24Hr,FP2)  ' Max 24Hr RMY05305 (3) Direction
  Sample (1,HWDir4Max24Hr,FP2)  ' Max 24Hr RMY05305 (4) Direction
  '----------------------------------------------------------------------
  Sample (2,HW1Max24HrTime(4),FP2)  ' Max 24Hr RMY05305 (1) time HH,MM
  Sample (2,HW2Max24HrTime(4),FP2)  ' Max 24Hr RMY05305 (2) time HH,MM
  Sample (2,HW3Max24HrTime(4),FP2)  ' Max 24Hr RMY05305 (3) time HH,MM
  Sample (2,HW4Max24HrTime(4),FP2)  ' Max 24Hr RMY05305 (4) time HH,MM
  '----------------------------------------------------------------------
  Sample (1,HWSpd1_max1min,FP2)  'Max 1min sustained RMY05305 (1) Wind Speed
  Sample (1,HWDir1_max1min,FP2)  'Max 1min sustained RMY05305 (1) Wind Direction
  Sample (2,HWTime1_max1min(4),FP2)  'Max 1min sustained RMY05305 (1) time HH,MM
  '----------------------------------------------------------------------
  Maximum(1,AirTemp1_DegC,FP2,False,True)  'Max MetOne060A2 (1) Air Temp & time HH,MM
  FieldNames("AirTemp1_DegC_MAX,AirTemp1_DegC_TMax")
  Minimum(1,AirTemp1_DegC,FP2,False,True)  'Min MetOne060A2 (1) Air Temp & time HH,MM
  FieldNames("AirTemp1_DegC_MIN,AirTemp1_DegC_TMin")
  '----------------------------------------------------------------------
  Maximum(1,BaroPres_mbar,FP2,False,False)  'Max CSI_CS100 Baro Pressure
  Minimum(1,BaroPres_mbar,FP2,False,False)  'Min CSI_CS100 Baro Pressure
  '----------------------------------------------------------------------
  Maximum(1,RotronAirT_DegC,FP2,False,False)  'Max Rotron MP101A AirTemp
  Minimum(1,RotronAirT_DegC,FP2,False,False)  'Min Rotron MP101A AirTemp
  Average(1,RotronAirT_DegC,FP2,False)  'Avg Rotron MP101A AirTemp
  '----------------------------------------------------------------------
  Maximum(1,DewPt_DegC,FP2,False,False)  'Max DewPoint
  Minimum(1,DewPt_DegC,FP2,False,False)  'Min DewPoint
  Average(1,DewPt_DegC,FP2,False)  'Avg Dew Point
  '-------------------------------------------------------------
  Maximum (1,RotronRH_percent,FP2,False,False)
  Minimum (1,RotronRH_percent,FP2,False,False)
  Average (1,RotronRH_percent,FP2,False)
  '-------------------------------------------------------------
  Totalize(1,Rain_inch,FP2,False)  'Total AW60103 rain
  FieldNames("Rain_TOTinch")
  '-------------------------------------------------------------
  '  Average(1,SWDN_Wm2,IEEE4,False)  'Avg SWDN solar radiation
  '  FieldNames("SWDN_AVGWm2")
  Totalize(1,SWDN_MJm2,IEEE4,False)  'Total SWDN flux density
  FieldNames("SWDN_TOTMJm2")
  '  Average(1,SWUP_Wm2,IEEE4,False)  'Avg SWUP solar radiation
  '  FieldNames("SWUP_AVGWm2")
  Totalize(1,SWUP_MJm2,IEEE4,False)  'Total SWUP flux density
  FieldNames("SWUP_TOTMJm2")
  '----------------------------------------------------------------------
  '  Average(1,LWDN_Wm2,FP2,False)  'Avg LWDN solar radiation
  '  FieldNames("LWDN_AVGWm2")
  Totalize(1,LWDN_MJm2,IEEE4,False)  'Total LWDN flux density
  FieldNames("LWDN_TOTMJm2")
  '  Average(1,LWUP_Wm2,FP2,False)  'Avg LWUP solar radiation
  '  FieldNames("LWUP_AVGWm2")
  Totalize(1,LWUP_MJm2,IEEE4,False)  'Total LWUP flux density
  FieldNames("LWUP_TOTMJm2")
  '----------------------------------------------------------------------
  Sample (1,NetRadMJm2_24Hr,IEEE4)  '24Hr NetRadiation MJm2
  '-------------------------------------------------------------
  Average (1,FuelM1Hr_prct,FP2,False)
  Average (1,FuelM10Hr_prct,FP2,False)
  '-------------------------------------------------------------
  Minimum(1,BattV,FP2,False,False)  ' Min Battery Voltage
  FieldNames("BattV_MINVolt")
  Minimum(1,PTemp_C,FP2,False,False)  ' Min datalogger Panel Temperature
  FieldNames("PTemp_MINDegC")
  Maximum(1,PTemp_C,FP2,False,False)  ' Max datalogger Panel Temperature
  FieldNames("PTemp_MAXDegC")
  '----------------------------------------------------------------------
  '=========================================================================
  Sample (1,SnowToday_in,FP2)'Added 1/26/18, JCR, daily snowfall (in)
  '=========================================================================
  Sample (1,Midnt_air_temp_C,FP2)
  FieldNames("Midnight_AirTemp_DegC")
  Sample (1,Midnt_RH,FP2)
  FieldNames("Midnight_RH_pct")
  Sample (1,Midnt_snow_in,FP2)
  FieldNames("Midnight_snow_depth_in")

  'Average (1,FuelM1Hr_prct,FP2,False)
  Minimum (1,FuelM1Hr_prct,FP2,False,False)
  Maximum (1,FuelM1Hr_prct,FP2,False,False)
  ' Average (1,FuelM10Hr_prct,FP2,False)
  Minimum (1,FuelM10Hr_prct,FP2,False,False)
  Maximum (1,FuelM10Hr_prct,FP2,False,False)

  Average (1,FuelTempC,FP2,False)
  Minimum (1,FuelTempC,FP2,False,False)
  Maximum (1,FuelTempC,FP2,False,False)
  Sample (1,FuelM100Hr_prct,FP2)
  Sample (1,FuelM1000Hr_prct,FP2)


EndTable
'***********************************************************************************
'15 minute table to store values that will be sent to Public table every 15 minutes
'===========================================================================
'Added by JCR 1/26/18
DataTable (Public15,True,1)
  DataInterval (0,15,Min,10)
  Totalize (1,Rain_inch,FP2,False)
  Maximum (1,HWSpd1_ms,FP2,HWSpd1_ms=NAN,False)
  Average (1,WindChill_C,FP2,False)
EndTable

DataTable (Dat1Hr,True,1)'table only one record in size, holding 1 hour of data
  DataInterval (0,1,Hr,1)
  Totalize (1,Rain_inch,FP2,False)
  FieldNames("HrRain_inch")
  Average (1,AirTemp1_DegC,FP2,False)
  FieldNames("HrAirT_C")
EndTable
'===========================================================================

'###################################################################################
'##### Subroutine ##################################################################
'###################################################################################
Sub SubCase
  ' 1/T = a + b(LnR) + c(LnR)^3
  ' a = 0.0010295 = ConstA
  ' b = 0.0002391 = ConstB
  ' c = 1.568E-7 = ConstC

  ' Calc resistance
  '   *** Mutiplier = bridge completion resistor
  PIRcaseRes = 1000*(PIRcaseRes/(1.0-PIRcaseRes))
  ' calculate temperature in degrees K
  ConstA = 0.0010295
  ConstB = 0.0002391
  ConstC = 1.568E-7
  PIRcaseC = ConstA + ConstB*(LN(PIRcaseRes)) + ConstC*(LN(PIRcaseRes))^3
  PIRcaseC = 1 / PIRcaseC
  ' Temp in degrees C
  PIRcaseC = PIRcaseC - 273.15
EndSub
'
'=========================================================================
Sub Stability
  'Find Vertical Pasquill-Gifford Stability Category
  Select Case SigmaPhi
  Case < 2.890
    V_PGCat = "F"
  Case < 6.022
    V_PGCat = "E"
  Case <9.394
    V_PGCat = "D"
  Case < 12.043
    V_PGCat = "C"
  Case < 13.85
    V_PGCat = "B"
  Case >=13.85
    V_PGCat = "A"
  End Select
  If Sun = True Then
    If V_PGCat = "A" Then
      Select Case u
      Case < 3
        V_PGCat = "A"
      Case < 4
        V_PGCat = "B"
      Case < 6
        V_PGCat = "C"
      Case >=6
        V_PGCat = "D"
      EndSelect
    ElseIf V_PGCat = "B" Then
      Select Case u
      Case < 4
        V_PGCat = "B"
      Case < 6
        V_PGCat = "C"
      Case >=6
        V_PGCat = "D"
      EndSelect
    ElseIf V_PGCat = "C" Then
      If u >= 6 Then V_PGCat = "D"
    ElseIf V_PGCat = "D" Then
      V_PGCat = "D"
    ElseIf V_PGCat = "E" Then
      V_PGCat = "D"
    ElseIf V_PGCat = "F" Then
      V_PGCat = "D"
    EndIf
  Else
    If V_PGCat = "A" Then
      V_PGCat = "D"
    ElseIf V_PGCat = "B" Then
      V_PGCat = "D"
    ElseIf V_PGCat = "C" Then
      V_PGCat = "D"
    ElseIf V_PGCat = "D" Then
      V_PGCat = "D"
    ElseIf V_PGCat = "E" Then
      If u >= 5 Then V_PGCat = "D"
    ElseIf V_PGCat = "F" Then
      Select Case u
      Case < 3
        V_PGCat = "F"
      Case < 5
        V_PGCat = "E"
      Case >=5
        V_PGCat = "D"
      EndSelect
    EndIf
  EndIf
  'Find Lateral Pasquill-Gifford Stability Category
  Select Case SigmaTheta
  Case < 4.576
    H_PGCat = "F"
  Case < 9.032
    H_PGCat = "E"
  Case <15.054
    H_PGCat = "D"
  Case < 21.075
    H_PGCat = "C"
  Case < 27.097
    H_PGCat = "B"
  Case >=27.097
    H_PGCat = "A"
  End Select
  If Sun = True Then
    If H_PGCat = "A" Then
      Select Case u
      Case < 3
        H_PGCat = "A"
      Case < 4
        H_PGCat = "B"
      Case < 6
        H_PGCat = "C"
      Case >=6
        H_PGCat = "D"
      EndSelect
    ElseIf H_PGCat = "B" Then
      Select Case u
      Case < 4
        H_PGCat = "B"
      Case < 6
        H_PGCat = "C"
      Case >=6
        H_PGCat = "D"
      EndSelect
    ElseIf H_PGCat = "C" Then
      If u >= 6 Then H_PGCat = "D"
    ElseIf H_PGCat = "D" Then
      H_PGCat = "D"
    ElseIf H_PGCat = "E" Then
      H_PGCat = "D"
    ElseIf H_PGCat = "F" Then
      H_PGCat = "D"
    EndIf
  Else
    If H_PGCat = "A" Then
      Select Case u
      Case < 2.9
        H_PGCat = "F"
      Case < 3.6
        H_PGCat = "E"
      Case >= 3.6
        H_PGCat = "D"
      EndSelect
    ElseIf H_PGCat = "B" Then
      Select Case u
      Case < 2.4
        H_PGCat = "F"
      Case < 3
        H_PGCat = "E"
      Case >= 3
        H_PGCat = "D"
      EndSelect
    ElseIf H_PGCat = "C" Then
      Select Case u
      Case < 2.4
        H_PGCat = "E"
      Case >= 2.4
        H_PGCat = "D"
      EndSelect
    ElseIf H_PGCat = "D" Then
      H_PGCat = "D"
    ElseIf H_PGCat = "E" Then
      If u >= 5 Then H_PGCat = "D"
    ElseIf H_PGCat = "F" Then
      Select Case u
      Case < 3
        H_PGCat = "F"
      Case < 5
        H_PGCat = "E"
      Case >=5
        H_PGCat = "D"
      EndSelect
    EndIf
  EndIf
EndSub
' End of subroutine to calculate P-G Stability Category
'=========================================================================

'
'###################################################################################
'##### Main Program ################################################################
'###################################################################################
'Main Scan -----------------------------------------------------------------------
BeginProg
  Scan(3,Sec,1,0)
    '---------------------------------------------------------------------
    ' Datalogger Battery Voltage measurement 'BattV'
    Battery(BattV)
    ' Datalogger Wiring Panel Temperature measurement 'PTemp_C'
    PanelTemp(PTemp_C,_60Hz)
    '---------------------------------------------------------------------
    'All Weather Rain Gauge wired to a control port, measurement 'Rain_inch'
    PulseCount(Rain_inch,1,13,2,0,0.01,0)
    '-------------------------------------------------------------------------
    '
    '  RMYoung 05305-AQ Wind Speed & Direction Sensor (1)
    '  Wind Speed & Direction Sensor measurements 'HWSpd1_ms' and 'HWDir1_deg'
    PulseCount(HWSpd1_ms,1,1,1,1,0.1024,0)
    BrHalf(HWDir1_deg,1,mV1000,1,1,1,1000,False,20000,_60Hz,355,0)
    If HWDir1_deg>=360 OR HWDir1_deg<0 Then HWDir1_deg=0
    '  RMYoung 05305-AQ Wind Speed & Direction Sensor (2)
    '  Wind Speed & Direction Sensor measurements 'HWSpd2_ms' and 'HWDir2_deg'
    PulseCount(HWSpd2_ms,1,2,1,1,0.1024,0)
    BrHalf(HWDir2_deg,1,mV1000,2,1,1,1000,False,20000,_60Hz,355,0)
    If HWDir2_deg>=360 OR HWDir2_deg<0 Then HWDir2_deg=0
    '  RMYoung 05305-AQ Wind Speed & Direction Sensor (3)
    '  Wind Speed & Direction Sensor measurements 'HWSpd3_ms' and 'HWDir3_deg'
    PulseCount(HWSpd3_ms,1,3,1,1,0.1024,0)
    BrHalf(HWDir3_deg,1,mV1000,3,1,1,1000,False,20000,_60Hz,355,0)
    If HWDir3_deg>=360 OR HWDir3_deg<0 Then HWDir3_deg=0
    '  RMYoung 05305-AQ Wind Speed & Direction Sensor (4)
    '  Wind Speed & Direction Sensor measurements 'HWSpd4_ms' and 'HWDir4_deg'
    PulseCount(HWSpd4_ms,1,4,1,1,0.1024,0)
    BrHalf(HWDir4_deg,1,mV1000,4,1,1,1000,False,20000,_60Hz,355,0)
    If HWDir4_deg>=360 OR HWDir4_deg<0 Then HWDir4_deg=0
    '---------------------------------------------------------------------
    ' Determine the HWSpeed, Direction & Time of Max Gust 4-levels
    ' for a 24Hr period
    If HWSpd1_ms > HWSpd1Max24Hr Then
      HWSpd1Max24Hr = HWSpd1_ms
      HWDir1Max24Hr = HWDir1_deg
      RealTime (HW1Max24HrTime())
    EndIf
    '
    If HWSpd2_ms > HWSpd2Max24Hr Then
      HWSpd2Max24Hr = HWSpd2_ms
      HWDir2Max24Hr = HWDir2_deg
      RealTime (HW2Max24HrTime())
    EndIf
    '
    If HWSpd3_ms > HWSpd3Max24Hr Then
      HWSpd3Max24Hr = HWSpd3_ms
      HWDir3Max24Hr = HWDir3_deg
      RealTime (HW3Max24HrTime())
    EndIf
    '
    If HWSpd4_ms > HWSpd4Max24Hr Then
      HWSpd4Max24Hr = HWSpd4_ms
      HWDir4Max24Hr = HWDir4_deg
      RealTime (HW4Max24HrTime())
    EndIf
    '=======================================================================
    If Dat15min.SWDN_AVGWm2 < 6 Then 'Night should be considered <6 W/m2 from shortwave down measurement
      Sun = False
    Else
      Sun = True
    EndIf
    '=======================================================================
    '---------------------------------------------------------------------
    '  RMYoung 27106T Wind Speed Sensor (1)
    '  Wind Speed Sensor measurements 'VWSpd1_ms'
    VoltSe(VWSpd1_ms,1,mV5000,5,True,0,_60Hz,0.0225,0)
    '  RMYoung 27106T Wind Speed Sensor (2)
    '  Wind Speed Sensor measurements 'VWSpd2_ms'
    VoltSe(VWSpd2_ms,1,mV5000,6,True,0,_60Hz,0.0225,0)
    '  RMYoung 27106T Wind Speed Sensor (3)
    '  Wind Speed Sensor measurements 'VWSpd3_ms'
    VoltSe(VWSpd3_ms,1,mV5000,7,True,0,_60Hz,0.0225,0)
    '  RMYoung 27106T Wind Speed Sensor (4)
    '  Wind Speed Sensor measurements 'VWSpd4_ms'
    VoltSe(VWSpd4_ms,1,mV5000,8,True,0,_60Hz,0.0225,0)
    '---------------------------------------------------------------------
    '  MetOne 060A2 Air Temp Sensor(1)
    '  measurements 'AirTemp1_DegC'    '  MetOne 060A2 Air Temp Sensor(1)
    BrHalf(AirTemp1_DegC,1,mV1000,9,2,1,1000,False,0,_60Hz,-147.0588,95.7353)
    '=======================================================================
    temp0_F = 1.8*AirTemp1_DegC + 32 'Convert air temp to deg F for wind chill calculation
    speed1_mph = 2.23694*HWSpd1_ms 'Convert level 1 wind speed to mph for wind chill calculation
    WindChill_F = 35.74 + (0.6215*temp0_F) - (35.75*speed1_mph^0.16) + (0.4275*temp0_F*speed1_mph^0.16)
    WindChill_C = (WindChill_F -32)/1.8 'Convert wind chill to deg C
    '=======================================================================
    '  MetOne 060A2 Air Temp Sensor(2)
    '  measurements 'AirTemp2_DegC'
    BrHalf(AirTemp2_DegC,1,mV1000,10,2,1,1000,False,0,_60Hz,-147.0588,95.7353)
    '  MetOne 060A2 Air Temp Sensor(3)
    '  measurements 'AirTemp3_DegC'
    BrHalf(AirTemp3_DegC,1,mV1000,11,2,1,1000,False,0,_60Hz,-147.0588,95.7353)
    '  MetOne 060A2 Air Temp Sensor(4)
    '  measurements 'AirTemp4_DegC'
    BrHalf(AirTemp4_DegC,1,mV1000,12,2,1,1000,False,0,_60Hz,-147.0588,95.7353)
    '  MetOne 060A2 Air Temp Sensor(5)
    '  measurements 'AirTemp5_DegC'
    BrHalf(AirTemp5_DegC,1,mV1000,13,2,1,1000,False,0,_60Hz,-147.0588,95.7353)
    '---------------------------------------------------------------------
    '  Rotronics MP101A Air Temp & RH Sensor (constant power)
    '  measurements 'RotronAirT_DegC' and 'RotronRH_percent'
    VoltSe(RotronAirT_DegC,1,mV1000,14,0,0,_60Hz,0.1,-40)
    VoltSe(RotronRH_percent,1,mV1000,15,0,0,_60Hz,0.1,0)
    '    If RotronRH_percent>100 AND RotronRH_percent<103 Then RotronRH_percent=100
    '---------------------------------------------------------------------
    '    CS100 Barometric Pressure Sensor measurement 'BaroPres_mbar'
    '    PortSet(1,1)
    VoltSe(BaroPres_mbar,1,mV5000,16,1,0,_60Hz,0.2,600)
    BaroPres_mbar=BaroPres_mbar*1
    '-------------------------------------------------------------------------
    ' To Do: !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
    ' Go To "Declare Variable" Section and enter values for;
    '  Const PSP1Cal=?.??  '* Enter PSP1Cal = Eppley SensitivityCal Constant in microVolt/WM^2
    '  Const PSP2Cal=?.??  '* Enter PSP2Cal = Eppley Sensitivity Cal Constant in microVolt/WM^2
    '!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
    ' Eppley PSP1 Precision Spectral Pyranometer (1)
    ' measurements 'SWDN_MJm2' and 'SWDN_Wm2'
    VoltDiff(SWDN_measure,1,mV20,9,True,0,_60Hz,1000,0)
    SWDN_Wm2=SWDN_measure/PSP1Cal  'ans in W/m2
    SWDN_MJm2=(SWDN_Wm2/1000000)*PScan  'ans in MJ/m2
    'If SWDN_Wm2<0 Then SWDN_Wm2=0

    ' Eppley PSP2 Precision Spectral Pyranometer (2)
    ' measurements 'SWUP_MJm2' and 'SWUP_Wm2'
    VoltDiff(SWUP_measure,1,mV20,10,True,0,_60Hz,1000,0)
    SWUP_Wm2=SWUP_measure/PSP2Cal  'ans in W/m2
    SWUP_MJm2=(SWUP_Wm2/1000000)*PScan  'ans in MJ/m2
    'If SWDN_Wm2<0 Then SWDN_Wm2=0
    If TimeIntoInterval(1,15,min)Then
      If Dat15min.SWUP_AVGWm2 < 6 Then 'Night should be considered <6 W/m2 from shortwave down measurement
        Sun = False
      Else
        Sun = True
      EndIf
      If Sun = True Then SunHourDuration = SunHourDuration+15
      Daylit = SunHourDuration/60'calculate hours of sun duration for a day
      If Dat15min.Rain_TOTinch > 0 Then Daily_Precip_Time = Daily_Precip_Time + 15
    EndIf

    '-------------------------------------------------------------------------
    ' To Do: !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
    ' Go To "Declare Variable" Section and enter values for;
    '  Const PIR1Cal=?.??  '* Enter PIR1Cal = Eppley Sensitivity Cal Constant in microVolt/WM^2
    '  Const PIR2Cal=?.??  '* Enter PIR2Cal = Eppley Sensitivity Cal Constant in microVolt/WM^2
    '!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
    'Temperatures - Measure YSI 44301 Resistance.
    BrHalf(PIRcaseRes,1,mv5000,25,VX3,1,1500,True,20000,_60Hz,1,0) 'Case Temperature
    'Pyrgeometer - Measure Eppley PIR
    VoltDiff(LWDNuV,1,mV20C,11,True,0,_60Hz,1000,0) 'Eppley PIR
    Call SubCase
    LWDNcaseRes=PIRcaseRes
    LWDNcaseC=PIRcaseC
    LWDNcaseK=LWDNcaseC+273.2
    '

    LWDN = LWDNuV/PIR1Cal
    LWDN_Wm2_Uncorrected = LWDN
    'Eppley Manual Eq2 LWDN_Corrected
    LWDN_Wm2= LWDN + (5.67E-8) * (LWDNcaseK)^4
    LWDN_MJm2=(LWDN_Wm2/1000000)*PScan
    '
    '--------------------------------------------------------------------------------
    'Temperatures - Measure YSI 44301 Resistance.
    BrHalf(PIRcaseRes,1,mv5000,26,VX3,1,1500,True,20000,_60Hz,1,0) 'Case Temperature
    'Pyrgeometer - Measure Eppley PIR
    VoltDiff(LWUPuV,1,mV20C,12,True,0,_60Hz,1000,0) 'Eppley PIR
    Call SubCase
    LWUPcaseRes=PIRcaseRes
    LWUPcaseC=PIRcaseC
    LWUPcaseK=LWUPcaseC+273.2
    '
    LWUP = LWUPuV/PIR2Cal
    LWUP_Wm2_Uncorrected = LWUP
    'Eppley Manual Eq2 LWDN_Corrected
    LWUP_Wm2 = LWUP + (5.67E-8) * (LWUPcaseK)^4
    LWUP_MJm2=(LWUP_Wm2/1000000)*PScan
    '
    '-------------------------------------------------------------------------
    '
    '***********************************************************************************
    ' Dew Point calculation 'DewPt_DegC' ***********************************************
    ' Air temperature and relative humidity (%) measurements are required for this calculation.
    ' Therefore, air temperature and relative humidity (%) sensors must be selected and
    ' configured before selecting and configuring this calculation.
    '
    'The equation used to calculate dew point is:
    ' Td=(241.88*ln(P/0.61078))/(17.558-ln(P/0.61078))
    ' where
    ' Td = dew point (Deg C)
    ' and P = vapor pressure (kPa)
    '
    'The equation Is an inverse of a version of Teten's equation (Tetens, O. 1930. Z. Geophys.,
    ' 6:297), optimized for dew points in the range -35 to 50 Deg C, and is accurate to within
    ' plus or minus 0.1 Deg C within that range.
    '
    ' Vapor pressure is calculated by the datalogger with the following equation:
    ' P=RH*Psw/100
    ' where
    ' RH = relative humidity (%)
    ' Psw = saturation vapor pressure (kPa) over water

    ' Saturation vapor pressure over water is calculated by the datalogger with the following
    ' approximating polynomial (see Lowe, P.R. 1977. J. Appl. Meteor., 16:100-103):
    ' Psw=6.107799961+T*(4.436518521*10^-1+T*(1.428945805*10^-2+T*(2.650648471*10^-4+T*(3.031240396*10^-6+T*(2.034080948*10^-8+6.136820929*10^-11*T)))))
    ' where
    ' T = air temperature (dry-bulb temperature) (Deg C)
    ' Some datalogger models have built in instructions for calculating P and Psw using the
    ' above equations (e.g. CRBasic DewPoint instruction and Edlog P56 instruction), others
    ' do not and will include the complete equations in the resulting datalogger program.

    ' Campbell Scientific has a "Calculating Dew Point from RH and Air Temperature"
    ' Application Note at
    ' ftp://ftp.campbellsci.com/pub/csl/outgoing/uk/technotes/16_oct05.pdf
    '***********************************************************************************
    AirTC=AirTemp1_DegC
    DewPoint(DewPt_DegC,AirTC,RotronRH_percent)
    If DewPt_DegC>AirTC OR DewPt_DegC=NAN Then DewPt_DegC=AirTC
    '-------------------------------------------------------------------------
    '-------------------------------------------------------------------------
    'CS505 Fuel Moisture Sensor (constant power) measurements 'FuelM_percent' and 'FuelM_uS'
    'CS500 removed 9/30/2021
    'PortSet(2,1)
    'PeriodAvg(FuelM10Hr_uS,1,mV5000,27,0,0,10,50,0.001,0)
    'FuelM10Hr_prct=-220.14+(365.89*FuelM10Hr_uS)+(-114.96*FuelM10Hr_uS^2)
    'PortSet(2,0)
    
    PortSet(5,1)' power on the fuel moisture sensor
  
    PeriodAvg(FuelM10Hr_uS,1,mV1000,27,0,0,100,10,1,0)

    If FuelM10Hr_uS <= 17.7 Then
      FuelM10Hr_prct=7.6298*FuelM10Hr_uS-130.0904
    Else
      FuelM10Hr_prct=0.0406*FuelM10Hr_uS^2+3.7685*FuelM10Hr_uS-73.7974
    EndIf
    PortSet(5,0)
    '------------------------------------------------------------------------
    'CS205 Fuel Temperature Sensor measurement
    Therm107 (FuelTempC,1,28,Vx4,0,_60Hz,1.0,0)
    '``````````````````````````````````````````````````````````````````````````````
    ' Source of previous calculation of EMC and 1 hr fuel moisture below is unknown, so
    '   switched to calculations from Cohen and Deeming reference instead. 
    '   The differences in 1 hr fuel moisture were found to be small.
    ' December 2021 - Ken Waight
    '````` Calculate 1Hour Fuel Moisture, "FuelM1Hr_prct" ```````````````````````````
     FuelTempF = 0.0 'Retain old variable to preserve order in output tables.
     rhfuel = 0.0    'Retain old variable to preserve order in output tables.
    'FuelTempF=(1.8*FuelTempC)+32
    'rhfuel=(1.0 - 0.25 * SWDN_Wm2 / 1353.0) * RotronRH_percent
    'If rhfuel <= 10 Then
      'EMC=0.0323+0.281*rhfuel-0.000578*rhfuel*FuelTempF
    'EndIf
    'If rhfuel > 10 AND rhfuel <= 50 Then
      'EMC=2.227+0.160*rhfuel-0.01418*FuelTempF
    'EndIf
    'If rhfuel > 50 Then
      'EMC=21.06+0.005565*rhfuel*rhfuel-0.00035*FuelTempF*rhfuel-0.483*rhfuel
    'EndIf
    'FuelM1Hr_prct=(4.12*EMC+FuelM10Hr_prct)/5.0
    '``````````````````````````````````````````````````````````````````````````````
    '----------------------------------------------------------

    CallTable Precip

    ' New calculation of EMC and 1 hr fuel moisture.
    ' Cohen, J.D. and J.E. Deeming, 1982?: The National Fire Danger Rating System: basic equations. 
    '   General Technical Report PSW-82, U.S. Forest Service, Pacific Southwest Forest and Range
    '   Experimental Station.
    ' December 2021 - Ken Waight
    AirTemp1_DegF = (1.8*AirTemp1_DegC)+32
    If RotronRH_percent < 10 Then
      EMC = 0.03229 + 0.281073*RotronRH_percent - 0.000578*AirTemp1_DegF*RotronRH_percent
    ElseIf RotronRH_percent>=10 AND RotronRH_percent < 50 Then
      EMC = 2.22749 + 0.160107*RotronRH_percent - 0.014784*AirTemp1_DegF
    ElseIf RotronRH_percent>= 50 Then
      EMC = 21.0606 + 0.005565*RotronRH_percent*RotronRH_percent - 0.00035*RotronRH_percent*AirTemp1_DegF - 0.483199*RotronRH_percent
    EndIf
    FuelM1Hr_prct = (4.12*EMC+FuelM10Hr_prct)/5.0

    CallTable EMC_Vals

    ' ---------------Calc 100 hr & 1000 Hr Fuel M--------
    If TimeIntoInterval(1439,1440,min) Then
      '100 Hr Fuel Moisture
      FuelM100Hr_Yest = Dat24Hr.FuelM100Hr_prct(1,1)
      If FuelM100Hr_Yest = NAN Then FuelM100Hr_Yest = 15 '(5 + 5*CLIMAT) where CLIMAT is regional and = 2
      '1st time through set to 10% so calc doesn't = NAN
      PPTDUR = Daily_Precip_Time/60 'Get time of precip in hours
      EMCBar = (Daylit*EMC_Vals.EMCMin(1,1) + (24.0-Daylit)*EMC_Vals.EMCMax(1,1))/24.0
      BNDRYH = ((24.0-PPTDUR)*EMCBar + PPTDUR*(0.5*PPTDUR + 41.0))/24.0
      FuelM100Hr_prct = FuelM100Hr_Yest+(BNDRYH-FuelM100Hr_Yest)*(1.0-0.87*EXP(-0.24))

      '1000 Hr Fuel Moisture
      'Calculate average of BNDRYT over previous seven days.
      BDYBAR = (BNDRYT(1)+BNDRYT(2)+BNDRYT(3)+BNDRYT(4)+BNDRYT(5)+BNDRYT(6)+BNDRYT(7)) / 7.0
      'PM1000 is the fuel moisture from seven days ago.
      PM1000 = MC1000(1)
      'Calculate new value of 1000 hr fuel moisture.
      FuelM1000Hr_prct = PM1000 + (BDYBAR-PM1000)*(1.00-0.82*EXP(-.168))
      'Now shift the arrays of BNDRYT and MC1000 forward one day, dropping the values
      '  from 7 days ago.
      For i = 1 To 6
        BNDRYT(i) = BNDRYT(i+1)
        MC1000(i) = MC1000(i+1)
      Next i
      'Add new values of 24 hr boundary condition and fuel moisture to the end of arrays.
      BNDRYT(7) = ((24.0-PPTDUR)*EMCBar + PPTDUR*(2.7*PPTDUR + 76.0))/24.0
      MC1000(7) = FuelM1000Hr_prct 
    EndIf
    '--------------end fuel moisture caclulation------------

    ' Read Time every 1minute ---------------------------------
    If TimeIntoInterval (0,1,Min) Then
      RealTime (HWTime1_1min())
    EndIf
    '
    '--------------------------------------------------------------------
    'Call Output Tables --------------------------------------------------
    CallTable Dat1min
    ' Redirect DatTable "Dat1min" variables to program variables
    HWSpd1_1min = Dat1min.HWSpd1_ms_WVc(1,1)
    HWDir1_1min = Dat1min.HWSpd1_ms_WVc(2,1)
    '----------------------------------------------------------------------
    ' Determine the HWSpeed, HWDirection & Time of Max 1min sustained gust 1-level
    ' for a 24Hr period and store into program varialbes for a 24Hr period
    If HWSpd1_1min > HWSpd1_max1min Then
      HWSpd1_max1min = HWSpd1_1min
      HWDir1_max1min = HWDir1_1min
      HWTime1_max1min(4) = HWTime1_1min(4)
      HWTime1_max1min(5) = HWTime1_1min(5)
    EndIf
    '
    '--------------------------------------------------------------------
    'Call Output Table --------------------------------------------------
    CallTable DatNetWm15min
    ' Redirect DatTable "DatNetWm15min" variables to program variables
    SWDNWm2_15min=DatNetWm15min.SWDN_Wm2_avg(1,1)
    SWUPWm2_15min=DatNetWm15min.SWUP_Wm2_avg(1,1)
    LWDNWm2_15min=DatNetWm15min.LWDN_Wm2_avg(1,1)
    LWUPWm2_15min=DatNetWm15min.LWUP_Wm2_avg(1,1)
    'compute Net Radiation using redirected program variables
    NetRadWm2_15min=(SWDNWm2_15min + LWDNWm2_15min) - (SWUPWm2_15min + LWUPWm2_15min)

    '--------------------------------------------------------------------
    'Call Output Table --------------------------------------------------
    CallTable DatNetMJ24Hr
    ' Redirect DatTable "DatNetMJ24Hr" variables to program variables
    SWDNMJm2_24Hr=DatNetMJ24Hr.SWDN_MJm2_tot(1,1)
    SWUPMJm2_24Hr=DatNetMJ24Hr.SWUP_MJm2_tot(1,1)
    LWDNMJm2_24Hr=DatNetMJ24Hr.LWDN_MJm2_tot(1,1)
    LWUPMJm2_24Hr=DatNetMJ24Hr.LWUP_MJm2_tot(1,1)
    'compute Net Radiation using redirected program variables
    NetRadMJm2_24Hr=(SWDNMJm2_24Hr + LWDNMJm2_24Hr) - (SWUPMJm2_24Hr + LWUPMJm2_24Hr)
    '
    '---------------------------------
    'Call Data Tables and Store Data
    '---------------------------------
    CallTable(Dat15min)
    '=================================================
    'added 3/14/18 by Jason Ritter to get midnight values from 15 minute table
    'modified by David Bruggeman on 1/25/19 to change the midnight air temperature from RotronAirT_DegC to AirTemp1_AVGDegC
    'midnight temperature should be measured from level 0 temperature
    If IfTime(0,24,Hr) Then
      Midnt_air_temp_C=Dat15min.AirTemp1_AVGDegC
      Midnt_RH=Dat15min.RotronRH_AVGpercent
      Midnt_snow_in=Dat15min.SnowDepth_in_Avg
    EndIf
    '=================================================
    CallTable(Dat24Hr)
    '---------------------------------------------------------------------
    '=======================================================================
    CallTable(Dat1Hr)'For snowfall calculation
    '=======================================================================
    CallTable(Public15) 'Added 1/26/18 by JCR for 15 minute Public table variables
    If IfTime(0,15,min) Then
      'Calculate stability (sigma phi and sigma theta) at level 1 only in the Public table every 15 minutes
      'Calculate stdev of vertical and horizontal wind
      SigmaPhi = (Dat15min.VWSpd1_StdDev(1,1)/Dat15min.HWSpd1_AVGms(1,1))*57.2958
      SigmaTheta = Dat15min.HWDir1_StdDev(1,1)
      u = Dat15Min.HWSpd1_AVGms(1,1)
      Call Stability
      PrecipToday=PrecipToday + Public15.Rain_inch_TOT
      WindChill_15min=Public15.WindChill_C_AVG
      If Public15.HWSpd1_ms_MAX>MaxGustToday Then
        MaxGustToday=Public15.HWSpd1_ms_MAX
      EndIf
    EndIf
    '=======================================================================
    ' At the beginning of a new day reset 24Hr variables
    If TimeIntoInterval (0,1,Day) Then
      HWSpd1_max1min = 0
      HWDir1_max1min = 0
      HWTime1_max1min(4) = 0
      HWTime1_max1min(5) = 0

      HWSpd1Max24Hr=0
      HWDir1Max24Hr=0
      HW1Max24HrTime(4)=0  'hour
      HW1Max24HrTime(5)=0  'minute
      '
      HWSpd2Max24Hr=0
      HWDir2Max24Hr=0
      HW2Max24HrTime(4)=0  'hour
      HW2Max24HrTime(5)=0  'minute
      '
      HWSpd3Max24Hr=0
      HWDir3Max24Hr=0
      HW3Max24HrTime(4)=0  'hour
      HW3Max24HrTime(5)=0  'minute
      '
      HWSpd4Max24Hr=0
      HWDir4Max24Hr=0
      HW4Max24HrTime(4)=0  'hour
      HW4Max24HrTime(5)=0  'minute

      '=========================================================================
      PrecipToday=0
      MaxGustToday=0
      SnowToday_in = 0
      SunHourDuration = 0
      Daylit = 0''MH 10/18  added this so it gets zeroed out at the end of day
      'Reset precip variables at end of each day.
      Daily_Precip_Time = 0.0
      '=========================================================================
    EndIf
  NextScan
  SlowSequence
  Scan (30,Sec,3,0)
    '----- Measure SR50 ------------------------------------------------------
    'SR50 Sonic Ranging Sensor (*Configured for: Pulse Train Wiring)
    ' *(Pulse Train Output Address = 5, 100Hz 0.1 inch/pulse)
    '-------------------------------------------------------------------------
    '***************************************************************************
    ' If 13minutes into a 15minute interval Then trigger snow measurements
    '***************************************************************************
    PortSet (8,0) 'White wire must be grounded

    If TimeIntoInterval (13,15,Min)Then
      Snow15min=True
      SnowCount = 0
      SR50Accumulator = 0
    EndIf

    If Snow15min = true Then
      SnowCount=SnowCount+1
      SDI12Recorder (Snow(),7,0,"M5!",1.0,0,-1) 'Distance in ft, quality number, not used
      Dist2Target = (Snow(1))*SQR((AirTemp1_DegC+273.15)/273.15)
      SnowDepth_in = (Dist2Target-SR50_offset) * -1
      SR50Accumulator = SR50Accumulator + SnowDepth_in
    EndIf
    '---------------------------------------------------------------------
    'Reset Snow15min variables & compute 15min avg snow depth(of 3 readings spaced 30 seconds apart)
    If SnowCount >= 3 Then
      Snow15min=false
      SnowDepth_in_Avg=SR50Accumulator/SnowCount
      SnowCount = 0
    EndIf
    '---------------------------------------------------------------------
    '=========================================================================
    '---------------------------------------------------------------------
    ' Snowfall Estimation
    '---------------------------------------------------------------------
    If IfTime(0,15,Min) Then
      'Update running record of last eight 15 minute snow readings
      For i = 8 To 2 Step -1
        Snow_15min(i)=Snow_15min(i-1)
      Next i
      Snow_15min(1)=SnowDepth_in_Avg

      For i = 2 To 7 Step 1 'Calculate 1.5 hours of smoothed snow depth (in)
        SmoothSnow(i-1)=(Snow_15min(i-1)+Snow_15min(i)+Snow_15min(i+1))/3
      Next i
    EndIf
    'Find the difference in smoothed snow depth (inches)
    For i = 1 To 4
      SnowDiff(i) = SmoothSnow(i+1)-SmoothSnow(i)
    Next i
    'At 15 past the hour, calculate the snow depth for the last hour
    If IfTime(15,60,Min) Then
      SnowHr_in = 0
      For i = 1 To 4
        If SnowDiff(i)>0 Then
          SnowHr_in = SnowHr_in + SnowDiff(i)
        EndIf
        SnowHr_in=Round (SnowHr_in,1)'Round hourly snowfall to the nearest 0.1 inch
      Next i
      'Test conditions to determine whether to use SnowHr_in
      LastHrPrecip = Dat1Hr.HrRain_inch
      'Average the four air temp readings from last hour (ignore the latest as it is in this hour)
      AirT_HrAvg = Dat1Hr.HrAirT_C
      '1) if the total of the increases over an hour was > 0.4" and precip was measured during the hour
      If SnowHr_in>0.4 Then
        If  LastHrPrecip > 0 Then
          SnowHr_in = SnowHr_in 'snowfall occurred, so use the hourly total
        EndIf
      Else
        SnowHr_in = 0'snowfall did not occur, so set hourly total to zero
      EndIf
      '2) 0.1 < SnowHr_in <=0.4 AND Precip occurred AND hourly avg air temp < 40 deg F
      If SnowHr_in > 0.1 Then
        If SnowHr_in<=0.4 Then
          If  LastHrPrecip > 0 Then
            If AirT_HrAvg < (40-32)/1.8 Then 'Check for air temp below 40 F
              SnowHr_in = SnowHr_in 'snowfall occurred, so use the hourly total
            EndIf
          EndIf
        Else
          SnowHr_in = 0'snowfall did not occur, so set hourly total to zero
        EndIf
      EndIf
      '3) if the SnowHr_in < 0.1", precip was measured during the hour and the average temperature was <= 32F, it is recorded as a trace
      If SnowHr_in < 0.1 Then
        If  LastHrPrecip > 0 Then
          If AirT_HrAvg < 0 Then 'Check for air temp below 32 F (0 C)
            SnowTrace = "T" 'Trace snowfall occurred
          EndIf
        Else
          SnowTrace = ""'Trace snowfall did not occur, so set trace to nil
        EndIf
      EndIf

      SnowToday_in = SnowToday_in + SnowHr_in
    EndIf
    '=========================================================================
  NextScan

EndProg
␀␀␀␀␀␀␀␀␀␀␀